@model IReadOnlyList<Mindora.Application.DTOs.Professional.ProviderDto>

@{
    ViewData["Title"] = "Professionals";
    var specialties = ViewBag.Specialties as IReadOnlyList<Mindora.Application.DTOs.Professional.SpecialtyDto>;
    var searchTerm = ViewBag.SearchTerm as string;
    var specialtyId = ViewBag.SpecialtyId as Guid?;
}

<div class="container mt-4">
    <h2 class="fw-bold mb-4">Mental Health Professionals</h2>

    <form method="get" class="row g-2 mb-4">
        <div class="col-md-4">
            <input type="text" name="searchTerm" class="form-control" placeholder="Search by name or specialty" value="@searchTerm" />
        </div>
        <div class="col-md-3">
            <select name="specialtyId" class="form-select">
                <option value="">All Specialties</option>
                @if (specialties != null)
                {
                    @foreach (var specialty in specialties)
                    {
                        <option value="@specialty.SpecialtyId" selected="@(specialtyId == specialty.SpecialtyId)">@specialty.Name</option>
                    }
                }
            </select>
        </div>
        <div class="col-md-2">
            <button type="submit" class="btn btn-outline-primary w-100">Filter</button>
        </div>
    </form>

    @if (Model.Count == 0)
    {
        <div class="alert alert-info">No professionals found.</div>
    }
    else
    {
        <div class="row g-4">
            @foreach (var provider in Model)
            {
                <div class="col-md-6 col-lg-4 d-flex">
                    <div class="card professional-card h-100 shadow-sm border-0 w-100">
                        <div class="card-body d-flex flex-column">
                            <div class="d-flex align-items-center gap-3 mb-3">
                                <div class="professional-avatar">
                                    @provider.FullName.Substring(0, 1).ToUpper()
                                </div>
                                <div>
                                    <h5 class="card-title mb-0">@provider.FullName</h5>
                                    <small class="text-muted">@provider.YearsOfExperience years exp.</small>
                                </div>
                            </div>

                            @if (provider.IsVerified)
                            {
                                <span class="badge bg-success mb-2 align-self-start">✓ Verified</span>
                            }

                            <p class="text-muted small flex-grow-1">
                                @(provider.Bio?.Length > 100 ? provider.Bio.Substring(0, 100) + "..." : provider.Bio)
                            </p>

                            <div class="d-flex justify-content-between align-items-center mb-2">
                                <span class="text-warning">★ @(provider.AverageRating?.ToString("F1") ?? "N/A")</span>
                                <span class="text-muted small">@provider.ReviewCount reviews</span>
                            </div>

                            <div class="d-flex flex-wrap gap-1 mb-3">
                                @foreach (var specialty in provider.Specialties.Take(3))
                                {
                                    <span class="badge bg-light text-dark">@specialty.Name</span>
                                }
                            </div>

                            <div class="d-flex flex-wrap gap-2 mt-auto">
                                <a asp-action="Details" asp-route-id="@provider.ProviderId" class="btn btn-sm btn-outline-primary">View Profile</a>
                                <a asp-action="Book" asp-route-id="@provider.ProviderId" class="btn btn-sm btn-primary">Book</a>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
</div>