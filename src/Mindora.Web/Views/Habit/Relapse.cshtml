@model IReadOnlyList<Mindora.Application.DTOs.Habit.RelapseLogDto>

@{
    ViewData["Title"] = "Relapse Log";
    var habitId = ViewBag.HabitId as Guid?;
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2 class="fw-bold">Relapse History</h2>
        <a asp-action="Index" class="btn btn-sm btn-outline-secondary">Back</a>
    </div>

    <form asp-action="LogRelapse" method="post" class="mb-4">
        <input type="hidden" name="id" value="@(habitId?.ToString() ?? Guid.Empty.ToString())" />
        <div class="row g-2">
            <div class="col-md-4">
                <input name="reason" class="form-control" placeholder="Reason" />
            </div>
            <div class="col-md-4">
                <input name="note" class="form-control" placeholder="Note" />
            </div>
            <div class="col-md-2">
                <button type="submit" class="btn btn-warning w-100">Log Relapse</button>
            </div>
        </div>
    </form>

    @if (Model.Count == 0)
    {
        <div class="alert alert-success">No relapses recorded. Keep going! 💪</div>
    }
    else
    {
        <table class="table table-bordered">
            <thead>
                <tr><th>Date</th><th>Reason</th><th>Note</th></tr>
            </thead>
            <tbody>
                @foreach (var relapse in Model)
                {
                    <tr>
                        <td>@relapse.RelapseDate.ToShortDateString()</td>
                        <td>@relapse.Reason</td>
                        <td>@relapse.Note</td>
                    </tr>
                }
            </tbody>
        </table>
    }
</div>