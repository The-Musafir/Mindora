@model Mindora.Application.DTOs.Habit.HabitStatisticsViewModel
@{
    ViewData["Title"] = $"Statistics · {Model.HabitName}";
}

<div class="container-fluid py-4" style="max-width: 1200px;">

    <!-- ============================================================
         PAGE HEADER
         ============================================================ -->
    <div class="mindora-page-header">
        <div>
            <h1 class="mindora-page-title">@Model.HabitName</h1>
            <p class="mindora-page-subtitle">
                @if (!string.IsNullOrEmpty(Model.CategoryName))
                {
                    <span class="badge bg-primary">@Model.CategoryName</span>
                }
                <span class="ms-2">Statistics & Progress</span>
            </p>
        </div>
        <div class="d-flex gap-2">
            <a asp-action="Details" asp-route-id="@Model.HabitId" class="btn btn-outline-secondary">
                ← Details
            </a>
            <a asp-action="Index" class="btn btn-outline-primary">
                All Habits
            </a>
        </div>
    </div>

    <!-- ============================================================
         STAT CARDS
         ============================================================ -->
    <div class="mindora-stat-grid">
        <!-- Current Streak -->
        <div class="mindora-stat-card">
            <div class="mindora-stat-icon" style="background: rgba(245, 158, 11, 0.12); color: #F59E0B;">
                <svg width="22" height="22" viewBox="0 0 24 24" fill="none"
                     stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M8.5 14.5A2.5 2.5 0 0 0 11 12c0-1.38-.5-2-1-3-1.072-2.143-.224-4.054 2-6 .5 2.5 2 4.9 4 6.5 2 1.6 3 3.5 3 5.5a7 7 0 1 1-14 0c0-1.153.433-2.294 1-3a2.5 2.5 0 0 0 2.5 2.5z" />
                </svg>
            </div>
            <div class="mindora-stat-value">@Model.CurrentStreak</div>
            <div class="mindora-stat-label">Current Streak (days)</div>
        </div>

        <!-- Longest Streak -->
        <div class="mindora-stat-card">
            <div class="mindora-stat-icon" style="background: rgba(139, 92, 246, 0.12); color: #8B5CF6;">
                <svg width="22" height="22" viewBox="0 0 24 24" fill="none"
                     stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <polyline points="23 6 13.5 15.5 8.5 10.5 1 18"></polyline>
                    <polyline points="17 6 23 6 23 12"></polyline>
                </svg>
            </div>
            <div class="mindora-stat-value">@Model.LongestStreak</div>
            <div class="mindora-stat-label">Longest Streak</div>
        </div>

        <!-- Completion Rate -->
        <div class="mindora-stat-card">
            <div class="mindora-stat-icon" style="background: rgba(16, 185, 129, 0.12); color: #10B981;">
                <svg width="22" height="22" viewBox="0 0 24 24" fill="none"
                     stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M22 11.08V12a10 10 0 1 1-5.93-9.14" />
                    <polyline points="22 4 12 14.01 9 11.01" />
                </svg>
            </div>
            <div class="mindora-stat-value">@Model.CompletionRateDisplay</div>
            <div class="mindora-stat-label">Completion Rate</div>
        </div>

        <!-- Total Completed -->
        <div class="mindora-stat-card">
            <div class="mindora-stat-icon" style="background: rgba(6, 182, 212, 0.12); color: #06B6D4;">
                <svg width="22" height="22" viewBox="0 0 24 24" fill="none"
                     stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <rect x="3" y="4" width="18" height="18" rx="2" ry="2" />
                    <line x1="16" y1="2" x2="16" y2="6" />
                    <line x1="8" y1="2" x2="8" y2="6" />
                    <line x1="3" y1="10" x2="21" y2="10" />
                </svg>
            </div>
            <div class="mindora-stat-value">@Model.CompletedLogs</div>
            <div class="mindora-stat-label">Days Completed</div>
        </div>

        <!-- Weekly Avg -->
        <div class="mindora-stat-card">
            <div class="mindora-stat-icon" style="background: rgba(236, 72, 153, 0.12); color: #EC4899;">
                <svg width="22" height="22" viewBox="0 0 24 24" fill="none"
                     stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <line x1="18" y1="20" x2="18" y2="10" />
                    <line x1="12" y1="20" x2="12" y2="4" />
                    <line x1="6" y1="20" x2="6" y2="14" />
                </svg>
            </div>
            <div class="mindora-stat-value">@Model.WeeklyAverageDisplay</div>
            <div class="mindora-stat-label">Weekly Average</div>
        </div>

        <!-- Monthly Avg -->
        <div class="mindora-stat-card">
            <div class="mindora-stat-icon" style="background: rgba(59, 130, 246, 0.12); color: #3B82F6;">
                <svg width="22" height="22" viewBox="0 0 24 24" fill="none"
                     stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <circle cx="12" cy="12" r="10" />
                    <polyline points="12 6 12 12 16 14" />
                </svg>
            </div>
            <div class="mindora-stat-value">@Model.MonthlyAverageDisplay</div>
            <div class="mindora-stat-label">Monthly Average</div>
        </div>

        <!-- Total Logs -->
        <div class="mindora-stat-card">
            <div class="mindora-stat-icon" style="background: rgba(100, 116, 139, 0.12); color: #64748B;">
                <svg width="22" height="22" viewBox="0 0 24 24" fill="none"
                     stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z" />
                    <polyline points="14 2 14 8 20 8" />
                </svg>
            </div>
            <div class="mindora-stat-value">@Model.TotalLogs</div>
            <div class="mindora-stat-label">Total Logs</div>
        </div>

        <!-- Relapses -->
        <div class="mindora-stat-card">
            <div class="mindora-stat-icon" style="background: rgba(239, 68, 68, 0.12); color: #EF4444;">
                <svg width="22" height="22" viewBox="0 0 24 24" fill="none"
                     stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M10.29 3.86L1.82 18a2 2 0 0 0 1.71 3h16.94a2 2 0 0 0 1.71-3L13.71 3.86a2 2 0 0 0-3.42 0z" />
                    <line x1="12" y1="9" x2="12" y2="13" />
                    <line x1="12" y1="17" x2="12.01" y2="17" />
                </svg>
            </div>
            <div class="mindora-stat-value">@Model.TotalRelapses</div>
            <div class="mindora-stat-label">Relapses</div>
        </div>
    </div>

    <!-- ============================================================
         30-DAY TREND CHART
         ============================================================ -->
    <div class="mindora-chart-card">
        <div class="mindora-chart-header">
            <div>
                <h3 class="mindora-chart-title">30-Day Progress</h3>
                <p class="mindora-chart-subtitle">Your completion trend over the last month</p>
            </div>
            <div class="mindora-chart-legend">
                <span class="mindora-legend-dot" style="background: #06B6D4;"></span>
                Completed days
            </div>
        </div>
        <div class="mindora-chart-body">
            <canvas id="trendChart"></canvas>
        </div>
    </div>

    <!-- ============================================================
         WEEKLY + HEATMAP (Row)
         ============================================================ -->
    <div class="row g-3">
        <!-- Weekly Bar Chart -->
        <div class="col-lg-7">
            <div class="mindora-chart-card h-100">
                <div class="mindora-chart-header">
                    <div>
                        <h3 class="mindora-chart-title">Weekly Progress</h3>
                        <p class="mindora-chart-subtitle">Last 8 weeks comparison</p>
                    </div>
                </div>
                <div class="mindora-chart-body">
                    <canvas id="weeklyChart"></canvas>
                </div>
            </div>
        </div>

        <!-- Heatmap -->
        <div class="col-lg-5">
            <div class="mindora-chart-card h-100">
                <div class="mindora-chart-header">
                    <div>
                        <h3 class="mindora-chart-title">Streak Calendar</h3>
                        <p class="mindora-chart-subtitle">Last 30 days at a glance</p>
                    </div>
                </div>
                <div class="heatmap-container">
                    <div class="heatmap-grid">
                        @foreach (var day in Model.HeatmapDays)
                        {
                            var cls = day.Completed ? "heatmap-day completed" : "heatmap-day missed";
                            <div class="@cls" title="@day.Date.ToString("MMM dd, yyyy")"></div>
                        }
                    </div>
                    <div class="heatmap-legend">
                        <span class="heatmap-legend-item">
                            <span class="heatmap-dot completed"></span> Completed
                        </span>
                        <span class="heatmap-legend-item">
                            <span class="heatmap-dot missed"></span> Missed
                        </span>
                    </div>
                </div>
            </div>
        </div>
    </div>

</div>

@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', function() {

            // ============================================================
            // 30-DAY TREND CHART
            // ============================================================
            const trendLabels = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(
                                            Model.Last30Days.Select(d => d.Date.ToString("MMM dd")).ToList()));

            const trendData = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(
                                            Model.Last30Days.Select(d => d.Completed ? 1 : 0).ToList()));

            MindoraCharts.line('trendChart', trendLabels, [{
                label: 'Completed',
                data: trendData,
                color: '#06B6D4',
                fill: true
            }], {
                plugins: {
                    tooltip: {
                        callbacks: {
                            label: function(ctx) {
                                return ctx.parsed.y === 1 ? '✅ Completed' : '❌ Missed';
                            }
                        }
                    }
                },
                scales: {
                    y: {
                        beginAtZero: true,
                        max: 1.2,
                        ticks: {
                            stepSize: 1,
                            callback: function(v) {
                                if (v === 1) return '✓';
                                if (v === 0) return '✗';
                                return '';
                            }
                        }
                    }
                }
            });

            // ============================================================
            // WEEKLY BAR CHART
            // ============================================================
            const weekLabels = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(
                                            Model.Last8Weeks.Select(w => w.WeekLabel).ToList()));

            const weekCompleted = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(
                                            Model.Last8Weeks.Select(w => w.Completed).ToList()));

            const weekTotal = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(
                                            Model.Last8Weeks.Select(w => w.Total).ToList()));

            MindoraCharts.bar('weeklyChart', weekLabels, [
                {
                    label: 'Completed',
                    data: weekCompleted,
                    color: '#06B6D4'
                },
                {
                    label: 'Total',
                    data: weekTotal,
                    color: 'rgba(148, 163, 184, 0.3)'
                }
            ], {
                plugins: {
                    legend: {
                        display: true,
                        position: 'top',
                        labels: {
                            usePointStyle: true,
                            color: '#64748B',
                            font: { size: 12 }
                        }
                    }
                }
            });
        });
    </script>
}