@{
    ViewData["Title"] = "About Us";
}

<div class="about-page">

    <!-- ============================================================
         HERO
         ============================================================ -->
    <section class="about-hero">
        <div class="about-hero-container">
            <span class="about-eyebrow">OUR STORY</span>
            <h1>About Mindora</h1>
            <p class="about-hero-subtitle">
                A mental wellness platform built with empathy, science, and technology —
                to help people recover, grow, and thrive.
            </p>
        </div>
    </section>

    <!-- ============================================================
         MISSION
         ============================================================ -->
    <section class="about-section">
        <div class="about-container">
            <div class="about-content-block">
                <span class="about-eyebrow">OUR MISSION</span>
                <h2>Mental wellness should be accessible to everyone.</h2>
                <p>
                    Mindora was born from a simple belief: everyone deserves access to
                    compassionate, evidence-based mental health support. We combine
                    habit recovery tools, professional guidance, community, and AI-powered
                    insights into one unified platform.
                </p>
                <p>
                    Our goal isn't just to help people manage symptoms — it's to empower
                    them to build lasting habits, understand themselves deeply, and
                    grow stronger through every season of life.
                </p>
            </div>

            <div class="about-values-grid">
                <div class="about-value-card">
                    <div class="about-value-icon">
                        <svg width="24" height="24" viewBox="0 0 24 24" fill="none"
                             stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z" />
                        </svg>
                    </div>
                    <h3>Compassion First</h3>
                    <p>Every feature is designed with empathy, never judgment.</p>
                </div>

                <div class="about-value-card">
                    <div class="about-value-icon">
                        <svg width="24" height="24" viewBox="0 0 24 24" fill="none"
                             stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <rect x="3" y="11" width="18" height="11" rx="2" ry="2" />
                            <path d="M7 11V7a5 5 0 0 1 10 0v4" />
                        </svg>
                    </div>
                    <h3>Privacy by Default</h3>
                    <p>Your data is yours. We never sell, never share without consent.</p>
                </div>

                <div class="about-value-card">
                    <div class="about-value-icon">
                        <svg width="24" height="24" viewBox="0 0 24 24" fill="none"
                             stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <polyline points="22 12 18 12 15 21 9 3 6 12 2 12" />
                        </svg>
                    </div>
                    <h3>Science-Backed</h3>
                    <p>Built on research in habit formation, CBT, and mindfulness.</p>
                </div>

                <div class="about-value-card">
                    <div class="about-value-icon">
                        <svg width="24" height="24" viewBox="0 0 24 24" fill="none"
                             stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2" />
                            <circle cx="9" cy="7" r="4" />
                            <path d="M23 21v-2a4 4 0 0 0-3-3.87" />
                            <path d="M16 3.13a4 4 0 0 1 0 7.75" />
                        </svg>
                    </div>
                    <h3>Community-Powered</h3>
                    <p>Nobody heals alone. Support is built into everything.</p>
                </div>
            </div>
        </div>
    </section>

    <!-- ============================================================
         STORY
         ============================================================ -->
    <section class="about-section about-section-alt">
        <div class="about-container-narrow">
            <span class="about-eyebrow">OUR STORY</span>
            <h2>From a personal journey to a platform.</h2>
            <p>
                Mindora started as a personal project — a response to watching loved ones
                struggle with addiction, anxiety, and burnout without accessible support.
            </p>
            <p>
                We realized that mental wellness tools were either too clinical, too
                expensive, or too generic. There was a gap between "meditation apps" and
                "seeing a therapist" — a space where daily habits, honest reflection,
                community, and professional care could coexist.
            </p>
            <p>
                Mindora was built to fill that gap — one habit, one journal entry, one
                honest conversation at a time.
            </p>
        </div>
    </section>

    <!-- ============================================================
         WHAT WE OFFER
         ============================================================ -->
    <section class="about-section">
        <div class="about-container">
            <div class="about-section-header">
                <span class="about-eyebrow">WHAT WE OFFER</span>
                <h2>Everything you need, in one place.</h2>
            </div>

            <div class="about-features-grid">
                <div class="about-feature-item">
                    <span class="about-feature-emoji">🎯</span>
                    <h4>Habit Recovery</h4>
                    <p>Break unhealthy patterns and build lasting ones.</p>
                </div>

                <div class="about-feature-item">
                    <span class="about-feature-emoji">📔</span>
                    <h4>Guided Journaling</h4>
                    <p>Reflect, track moods, and understand yourself.</p>
                </div>

                <div class="about-feature-item">
                    <span class="about-feature-emoji">🤖</span>
                    <h4>AI Wellness Coach</h4>
                    <p>24/7 compassionate support, always available.</p>
                </div>

                <div class="about-feature-item">
                    <span class="about-feature-emoji">👥</span>
                    <h4>Supportive Community</h4>
                    <p>Connect with people who truly understand.</p>
                </div>

                <div class="about-feature-item">
                    <span class="about-feature-emoji">🩺</span>
                    <h4>Professional Support</h4>
                    <p>Licensed therapists, one click away.</p>
                </div>

                <div class="about-feature-item">
                    <span class="about-feature-emoji">📊</span>
                    <h4>Insights & Analytics</h4>
                    <p>Understand your patterns through data.</p>
                </div>
            </div>
        </div>
    </section>

    <!-- ============================================================
         FOUNDER
         ============================================================ -->
    <section class="about-section about-section-alt">
        <div class="about-container-narrow">
            <div class="about-founder-card">
                <div class="about-founder-avatar">B</div>
                <div class="about-founder-info">
                    <span class="about-eyebrow">FOUNDER</span>
                    <h3>Bithix</h3>
                    <p class="about-founder-role">Founder & Developer</p>
                    <p class="about-founder-bio">
                        Building Mindora to make mental wellness support accessible,
                        affordable, and human — for everyone.
                    </p>
                </div>
            </div>
        </div>
    </section>

    <!-- ============================================================
         CTA
         ============================================================ -->
    <section class="about-cta-section">
        <div class="about-cta-card">
            <h2>Start your journey with us.</h2>
            <p>Small steps every day can create meaningful change.</p>
            <div class="about-cta-actions">
                @if (User.Identity?.IsAuthenticated == true)
                {
                    <a asp-controller="Habit" asp-action="Index" class="about-cta-btn primary">
                        Go to Dashboard
                    </a>
                }
                else
                {
                    <a asp-area="Identity" asp-page="/Account/Register" class="about-cta-btn primary">
                        Get Started Free
                    </a>
                    <a asp-area="Identity" asp-page="/Account/Login" class="about-cta-btn secondary">
                        Sign In
                    </a>
                }
            </div>
        </div>
    </section>

    <!-- ============================================================
         BACK
         ============================================================ -->
    <div class="about-back-wrapper">
        <a asp-controller="Home" asp-action="Index" class="legal-back-link">← Back to Home</a>
    </div>

</div>