@model Mindora.Application.DTOs.AI.AIWellnessCoachSessionDto

@{
    ViewData["Title"] = "AI Chat";
}

<div class="container mt-4" style="max-width: 800px;">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="fw-bold">AI Wellness Coach</h2>
            <p class="text-muted small">Session started @Model.StartedAt.ToString("g")</p>
        </div>
        <a asp-action="Index" class="btn btn-outline-secondary btn-sm">Back</a>
    </div>

    <div class="ai-chat-container mb-3">
        @if (Model.Messages.Count == 0)
        {
            <p class="text-muted text-center mt-3">Start the conversation. I'm here to listen.</p>
        }
        else
        {
            @foreach (var message in Model.Messages)
            {
                <div class="ai-chat-bubble @(message.Sender == "User" ? "user" : "ai")">
                    @message.Content
                    <div class="small mt-1 @(message.Sender == "User" ? "text-white-50" : "text-muted")">
                        @message.SentAt.ToString("t")
                    </div>
                </div>
            }
        }
    </div>

    <form asp-action="SendMessage" method="post" class="d-flex gap-2">
        <input type="hidden" name="SessionId" value="@Model.SessionId" />
        <input type="text" name="Content" class="form-control ai-chat-input" placeholder="Type your message..." required />
        <button type="submit" class="btn btn-primary px-4">Send</button>
    </form>

    @if (Model.IsActive)
    {
        <form asp-action="EndSession" asp-route-id="@Model.SessionId" method="post" class="mt-3 text-end">
            <button type="submit" class="btn btn-outline-danger btn-sm">End Session</button>
        </form>
    }

    <div class="mt-4">
        <h5 class="fw-bold mb-2">Feedback</h5>
        <form asp-action="AddFeedback" method="post" class="row g-2">
            <input type="hidden" name="SessionId" value="@Model.SessionId" />
            <div class="col-md-2">
                <select name="Rating" class="form-select" required>
                    <option value="5">5</option>
                    <option value="4">4</option>
                    <option value="3">3</option>
                    <option value="2">2</option>
                    <option value="1">1</option>
                </select>
            </div>
            <div class="col-md-7">
                <input type="text" name="Comment" class="form-control" placeholder="How was this response?" />
            </div>
            <div class="col-md-3">
                <button type="submit" class="btn btn-sm btn-primary w-100">Submit</button>
            </div>
        </form>
    </div>
</div>