@model Mindora.Application.DTOs.Notification.NotificationTemplateDto

@{
    ViewData["Title"] = "Create Template";
}

<div class="container mt-4" style="max-width: 650px;">
    <h2 class="fw-bold mb-4">Create Notification Template</h2>

    <form asp-action="CreateTemplate" method="post">
        <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

        <div class="mb-3">
            <label asp-for="TemplateKey" class="form-label">Template Key</label>
            <input asp-for="TemplateKey" class="form-control" placeholder="e.g., HabitReminder" />
            <span asp-validation-for="TemplateKey" class="text-danger"></span>
        </div>

        <div class="mb-3">
            <label asp-for="Subject" class="form-label">Subject</label>
            <input asp-for="Subject" class="form-control" />
        </div>

        <div class="mb-3">
            <label asp-for="BodyTemplate" class="form-label">Body Template</label>
            <textarea asp-for="BodyTemplate" class="form-control" rows="5" placeholder="Hello {UserName}, remember to {HabitName}"></textarea>
        </div>

        <div class="row">
            <div class="col-md-6 mb-3">
                <label asp-for="Channel" class="form-label">Channel</label>
                <select asp-for="Channel" class="form-select">
                    <option value="InApp">In-App</option>
                    <option value="Email">Email</option>
                    <option value="Push">Push</option>
                </select>
            </div>
            <div class="col-md-6 mb-3">
                <label asp-for="IsActive" class="form-label d-block">Active</label>
                <div class="form-check form-switch">
                    <input asp-for="IsActive" class="form-check-input" type="checkbox" checked />
                </div>
            </div>
        </div>

        <button type="submit" class="btn btn-primary">Create Template</button>
        <a asp-action="Templates" class="btn btn-outline-secondary">Cancel</a>
    </form>
</div>