@model IReadOnlyList<Mindora.Application.DTOs.Notification.NotificationDto>

@{
    ViewData["Title"] = "Notifications";
    var unreadCount = ViewBag.UnreadCount as int? ?? 0;
}

<div class="container mt-4">
    <div class="d-flex flex-wrap justify-content-between align-items-center mb-4 gap-2">
        <h2 class="fw-bold">Notifications</h2>
        <div class="d-flex gap-2">
            <a asp-action="Preferences" class="btn btn-outline-secondary btn-sm">Settings</a>
            @if (unreadCount > 0)
            {
                <form asp-action="MarkAllAsRead" method="post" class="d-inline">
                    <button type="submit" class="btn btn-sm btn-primary">Mark All as Read</button>
                </form>
            }
        </div>
    </div>

    @if (Model.Count == 0)
    {
        <div class="alert alert-info">You have no notifications.</div>
    }
    else
    {
        <div class="d-flex flex-column gap-3">
            @foreach (var notification in Model)
            {
                <div class="card notification-card @(notification.IsRead ? "read" : "unread") shadow-sm border-0 w-100">
                    <div class="card-body d-flex flex-column">
                        <div class="d-flex justify-content-between align-items-start flex-wrap gap-2">
                            <div class="flex-grow-1">
                                <h5 class="card-title mb-1 fw-semibold">@notification.Title</h5>
                                <span class="notification-badge bg-primary text-white">@notification.Type</span>
                                <span class="text-muted small ms-2">@notification.CreatedAt.ToShortDateString() @notification.CreatedAt.ToShortTimeString()</span>
                            </div>
                            <span class="badge @(notification.IsRead ? "bg-secondary" : "bg-success")">
                                @(notification.IsRead ? "Read" : "Unread")
                            </span>
                        </div>
                        <p class="text-muted small mb-2 mt-2">@notification.Body</p>

                        <div class="d-flex flex-wrap gap-2 mt-auto">
                            @if (!notification.IsRead)
                            {
                                <form asp-action="MarkAsRead" asp-route-id="@notification.NotificationId" method="post" class="d-inline">
                                    <button type="submit" class="btn btn-sm btn-outline-primary">Mark as Read</button>
                                </form>
                            }
                            <form asp-action="Delete" asp-route-id="@notification.NotificationId" method="post" class="d-inline">
                                <button type="submit" class="btn btn-sm btn-outline-danger">Delete</button>
                            </form>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
</div>