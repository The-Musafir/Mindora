@model IReadOnlyList<Mindora.Application.DTOs.Payment.PayoutDto>

@{
    ViewData["Title"] = "Payout Management";
}

<div class="container mt-4">
    <h2 class="fw-bold mb-4">Payout Requests</h2>

    @if (Model.Count == 0)
    {
        <div class="alert alert-info">No payout requests.</div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-hover align-middle">
                <thead class="table-light">
                    <tr>
                        <th>Provider</th>
                        <th>Amount</th>
                        <th>Method</th>
                        <th>Status</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var payout in Model)
                    {
                        <tr>
                            <td>@payout.ProviderName</td>
                            <td>@payout.Amount</td>
                            <td>@payout.Method</td>
                            <td>@payout.Status</td>
                            <td>
                                @if (payout.Status == "Pending")
                                {
                                    <form asp-action="UpdateStatus" method="post" class="d-inline">
                                        <input type="hidden" name="PayoutId" value="@payout.PayoutId" />
                                        <button type="submit" name="Status" value="Approved" class="btn btn-sm btn-success">Approve</button>
                                        <button type="submit" name="Status" value="Rejected" class="btn btn-sm btn-danger">Reject</button>
                                    </form>
                                }
                                @if (payout.Status == "Approved")
                                {
                                    <form asp-action="UpdateStatus" method="post" class="d-inline">
                                        <input type="hidden" name="PayoutId" value="@payout.PayoutId" />
                                        <button type="submit" name="Status" value="Paid" class="btn btn-sm btn-primary">Mark Paid</button>
                                    </form>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>