@model IReadOnlyList<Mindora.Application.DTOs.Reporting.ScheduledReportDto>

@{
    ViewData["Title"] = "Scheduled Reports";
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2 class="fw-bold">Scheduled Reports</h2>
        <a asp-action="Create" class="btn btn-primary btn-sm">+ New Schedule</a>
    </div>

    @if (TempData["Message"] != null)
    {
        <div class="alert alert-success">@TempData["Message"]</div>
    }

    @if (Model.Count == 0)
    {
        <div class="alert alert-info">No scheduled reports yet.</div>
    }
    else
    {
        <div class="reporting-card shadow-sm">
            <div class="table-responsive">
                <table class="table reporting-table table-hover align-middle">
                    <thead class="table-light">
                        <tr>
                            <th>Report Type</th>
                            <th>Frequency</th>
                            <th>Format</th>
                            <th>Next Run</th>
                            <th>Recipients</th>
                            <th>Status</th>
                            <th>Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var s in Model)
                        {
                            <tr>
                                <td>@s.ReportType</td>
                                <td>@s.Frequency</td>
                                <td>@s.Format</td>
                                <td>@(s.NextRunAt?.ToString("g") ?? "-")</td>
                                <td>@s.RecipientCount</td>
                                <td>
                                    <span class="reporting-badge @(s.IsActive ? "bg-success text-white" : "bg-secondary text-white")">
                                        @(s.IsActive ? "Active" : "Inactive")
                                    </span>
                                </td>
                                <td>
                                    <form asp-action="RunNow" method="post" class="d-inline">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="scheduledReportId" value="@s.ScheduledReportId" />
                                        <button type="submit" class="btn btn-sm btn-outline-primary">Run Now</button>
                                    </form>
                                    <a asp-controller="ReportRecipient" asp-action="Index" asp-route-scheduledReportId="@s.ScheduledReportId"
                                       class="btn btn-sm btn-outline-info">Recipients</a>
                                    <form asp-action="ToggleActive" method="post" class="d-inline">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="scheduledReportId" value="@s.ScheduledReportId" />
                                        <button type="submit" name="isActive" value="@(!s.IsActive)"
                                                class="btn btn-sm @(s.IsActive ? "btn-outline-secondary" : "btn-outline-success")">
                                            @(s.IsActive ? "Pause" : "Activate")
                                        </button>
                                    </form>
                                    <form asp-action="Delete" method="post" class="d-inline">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="scheduledReportId" value="@s.ScheduledReportId" />
                                        <button type="submit" class="btn btn-sm btn-outline-danger">Delete</button>
                                    </form>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }
</div>