@model Mindora.Application.DTOs.Reporting.CreateScheduledReportRequest

@{
    ViewData["Title"] = "Create Scheduled Report";
    var templates = ViewBag.Templates as IReadOnlyList<Mindora.Application.DTOs.Reporting.ReportTemplateDto>;
}

<div class="container mt-4" style="max-width: 650px;">
    <h2 class="fw-bold mb-4">Create Scheduled Report</h2>

    <form asp-action="Create" method="post">
        <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

        <div class="mb-3">
            <label class="form-label">Report Template</label>
            <select id="templateSelect" class="form-select">
                <option value="">-- Select Template --</option>
                @if (templates != null)
                {
                    @foreach (var t in templates)
                    {
                        <option value="@t.TemplateKey" data-format="@t.DefaultFormat">@t.Name (@t.Category)</option>
                    }
                }
            </select>
        </div>

        <div class="mb-3">
            <label asp-for="ReportType" class="form-label">Report Type</label>
            <input asp-for="ReportType" class="form-control" id="reportType" readonly />
        </div>

        <div class="row">
            <div class="col-md-6 mb-3">
                <label asp-for="Format" class="form-label">Format</label>
                <select asp-for="Format" class="form-select" id="formatSelect">
                    <option value="CSV">CSV</option>
                    <option value="Excel">Excel</option>
                    <option value="PDF">PDF</option>
                </select>
            </div>
            <div class="col-md-6 mb-3">
                <label asp-for="Frequency" class="form-label">Frequency</label>
                <select asp-for="Frequency" class="form-select">
                    <option value="Daily">Daily</option>
                    <option value="Weekly">Weekly</option>
                    <option value="Monthly">Monthly</option>
                </select>
            </div>
        </div>

        <div class="mb-3">
            <label asp-for="ScheduledTime" class="form-label">Scheduled Time</label>
            <input asp-for="ScheduledTime" class="form-control" type="time" />
            <small class="text-muted">রিপোর্টটি দৈনিক এই সময়ে জেনারেট হবে (UTC)।</small>
        </div>

        <div class="form-check form-switch mb-3">
            <input asp-for="IsActive" class="form-check-input" type="checkbox" checked />
            <label asp-for="IsActive" class="form-check-label">Active</label>
        </div>

        <button type="submit" class="btn btn-primary">Create Schedule</button>
        <a asp-action="Index" class="btn btn-outline-secondary">Cancel</a>
    </form>
</div>

@section Scripts {
    <script>
        document.getElementById('templateSelect').addEventListener('change', function() {
            const option = this.options[this.selectedIndex];
            document.getElementById('reportType').value = option.value || '';
            const fmt = option.getAttribute('data-format');
            if (fmt) document.getElementById('formatSelect').value = fmt;
        });
    </script>
}