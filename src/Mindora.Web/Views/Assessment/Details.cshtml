@model Mindora.Application.DTOs.Assessment.AssessmentQuestionnaireDto

@{
    ViewData["Title"] = Model.Title;
}

<div class="container mt-4">
    <nav aria-label="breadcrumb">
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a asp-action="Index">Assessments</a></li>
            <li class="breadcrumb-item active">@Model.Title</li>
        </ol>
    </nav>

    <div class="card shadow-sm border-0">
        <div class="card-body">
            <h2 class="fw-bold mb-3">@Model.Title</h2>
            <p class="text-muted">@Model.Description</p>

            <hr />

            <h5 class="fw-bold mb-3">Questions</h5>
            @foreach (var question in Model.Questions)
            {
                <div class="mb-4">
                    <p class="fw-semibold">@question.OrderIndex. @question.QuestionText</p>
                    <ul class="list-unstyled ms-3">
                        @foreach (var option in question.Options)
                        {
                            <li class="mb-1"><span class="text-muted">•</span> @option.OptionText</li>
                        }
                    </ul>
                </div>
            }

            <div class="mt-4">
                <a asp-action="Take" asp-route-id="@Model.QuestionnaireId" class="btn btn-primary">Take Assessment</a>
                <a asp-action="Index" class="btn btn-outline-secondary">Back</a>
            </div>
        </div>
    </div>
</div>