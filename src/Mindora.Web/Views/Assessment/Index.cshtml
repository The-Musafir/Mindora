@model IReadOnlyList<Mindora.Application.DTOs.Assessment.AssessmentQuestionnaireDto>

@{
    ViewData["Title"] = "Assessments";
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2 class="fw-bold">Psychological Assessments</h2>
        <a asp-action="History" class="btn btn-outline-secondary btn-sm">View History</a>
    </div>

    @if (Model == null || Model.Count == 0)
    {
        <div class="alert alert-info">
            <i class="bi bi-info-circle me-2"></i>No assessments available right now.
        </div>
    }
    else
    {
        <div class="row g-4">
            @foreach (var assessment in Model)
            {
                <div class="col-md-6 col-lg-4 d-flex">
                    <div class="card h-100 shadow-sm border-0 w-100 assessment-card">
                        <div class="card-body d-flex flex-column">
                            <h5 class="card-title fw-bold">@assessment.Title</h5>
                            <p class="text-muted small flex-grow-1">@assessment.Description</p>
                            <div class="d-flex flex-wrap gap-2 mt-auto">
                                <a asp-action="Details"
                                   asp-route-id="@assessment.QuestionnaireId"
                                   class="btn btn-sm btn-outline-primary">
                                    Details
                                </a>
                                <a asp-action="Take"
                                   asp-route-id="@assessment.QuestionnaireId"
                                   class="btn btn-sm btn-primary">
                                    Take Assessment
                                </a>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
</div>