@model IReadOnlyList<Mindora.Application.DTOs.Assessment.UserAssessmentHistoryDto>

@{
    ViewData["Title"] = "Assessment History";
}

<div class="container mt-4">
    <h2 class="fw-bold mb-4">Assessment History</h2>

    @if (Model.Count == 0)
    {
        <div class="alert alert-info">No assessments taken yet.</div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-hover align-middle">
                <thead class="table-light">
                    <tr>
                        <th>Date</th>
                        <th>Assessment</th>
                        <th>Status</th>
                        <th>Score</th>
                        <th>Risk Level</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td>@item.StartedAt.ToShortDateString()</td>
                            <td>@item.QuestionnaireTitle</td>
                            <td>
                                <span class="badge @(item.Status == "Completed" ? "bg-success" : "bg-warning text-dark")">
                                    @item.Status
                                </span>
                            </td>
                            <td>@item.TotalScore</td>
                            <td>
                                @if (item.SeverityLevel != null)
                                {
                                    <span class="badge @(item.SeverityLevel == "Low" ? "bg-success" : item.SeverityLevel == "Moderate" ? "bg-warning text-dark" : "bg-danger")">
                                        @item.SeverityLevel
                                    </span>
                                }
                            </td>
                            <td>
                                <a asp-action="Result" asp-route-id="@item.UserAssessmentId" class="btn btn-sm btn-outline-primary">View Result</a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>