@model IReadOnlyList<Mindora.Application.DTOs.Payment.SubscriptionPlanDto>

@{
    ViewData["Title"] = "Pricing Plans";
}

<div class="container mt-4">
    <h2 class="fw-bold mb-4">Choose Your Plan</h2>

    @if (Model.Count == 0)
    {
        <div class="alert alert-info">No subscription plans available right now.</div>
    }
    else
    {
        <div class="row g-4">
            @foreach (var plan in Model)
            {
                <div class="col-md-6 col-lg-4 d-flex">
                    <div class="card payment-card h-100 shadow-sm border-0 w-100">
                        <div class="card-body d-flex flex-column">
                            <h5 class="payment-plan-name">@plan.Name</h5>
                            <p class="text-muted small flex-grow-1">@plan.Description</p>

                            <div class="payment-plan-price mb-2">
                                $@plan.Price
                                <span class="text-muted fs-6 fw-normal">/ @(plan.DurationDays / 30) month(s)</span>
                            </div>

                            <div class="d-flex flex-wrap gap-2 mt-auto">
                                <form asp-action="Subscribe" method="post">
                                    <input type="hidden" name="planId" value="@plan.PlanId" />
                                    <button type="submit" class="btn btn-sm btn-primary">Subscribe</button>
                                </form>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
</div>