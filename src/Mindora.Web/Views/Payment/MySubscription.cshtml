@model IReadOnlyList<Mindora.Application.DTOs.Payment.UserSubscriptionDto>

@{
    ViewData["Title"] = "My Subscription";
    var current = ViewBag.Current as Mindora.Application.DTOs.Payment.UserSubscriptionDto;
}

<div class="container mt-4">
    <h2 class="fw-bold mb-4">My Subscription</h2>

    @if (current == null)
    {
        <div class="alert alert-info">You don't have an active subscription. <a asp-action="Plans">Browse plans</a>.</div>
    }
    else
    {
        <div class="card payment-card shadow-sm border-0 mb-4">
            <div class="card-body">
                <div class="d-flex justify-content-between align-items-start flex-wrap gap-3">
                    <div>
                        <h5 class="payment-plan-name">@current.PlanName</h5>
                        <p class="text-muted mb-0">Started: @current.StartDate.ToShortDateString()</p>
                        <p class="text-muted">Ends: @current.EndDate.ToShortDateString()</p>
                    </div>
                    <span class="payment-badge bg-success text-white">Active</span>
                </div>
                <form asp-action="CancelSubscription" method="post" class="mt-3">
                    <input type="hidden" name="subscriptionId" value="@current.SubscriptionId" />
                    <button type="submit" class="btn btn-sm btn-outline-danger">Cancel Subscription</button>
                </form>
            </div>
        </div>
    }

    <h5 class="fw-bold mb-3">Subscription History</h5>
    @if (Model.Count == 0)
    {
        <div class="alert alert-info">No subscription history.</div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table payment-table table-hover align-middle">
                <thead class="table-light">
                    <tr>
                        <th>Plan</th>
                        <th>Start</th>
                        <th>End</th>
                        <th>Status</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var sub in Model)
                    {
                        <tr>
                            <td>@sub.PlanName</td>
                            <td>@sub.StartDate.ToShortDateString()</td>
                            <td>@sub.EndDate.ToShortDateString()</td>
                            <td>
                                <span class="payment-badge @(sub.Status == "Active" ? "bg-success" : sub.Status == "Cancelled" ? "bg-secondary" : "bg-warning text-dark") text-white">
                                    @sub.Status
                                </span>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>