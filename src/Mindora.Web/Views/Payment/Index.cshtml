@using Mindora.Application.DTOs.Payment
@{
    ViewData["Title"] = "Billing";
    var plans = Model as IReadOnlyList<SubscriptionPlanDto> ?? new List<SubscriptionPlanDto>();
    var current = ViewBag.CurrentSubscription as UserSubscriptionDto;
    var recentPayments = ViewBag.RecentPayments as List<PaymentResponseDto> ?? new List<PaymentResponseDto>();
    var recentInvoices = ViewBag.RecentInvoices as List<InvoiceDto> ?? new List<InvoiceDto>();
    decimal totalSpent = ViewBag.TotalSpent ?? 0m;
    int paymentCount = ViewBag.PaymentCount ?? 0;
}

<div class="container-fluid py-4">

    <!-- ============================================================
         PAGE HEADER
         ============================================================ -->
    <div class="mb-4">
        <h1 class="h3 fw-bold mb-1">Billing & Subscription</h1>
        <p class="text-muted mb-0">Manage your subscription, payments, and invoices.</p>
    </div>

    <!-- ============================================================
         STATS CARDS
         ============================================================ -->
    <div class="row g-3 mb-4">
        <div class="col-md-3 col-sm-6">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-start mb-3">
                        <div class="rounded-3 p-2" style="background: rgba(6,182,212,.12);">
                            <svg width="20" height="20" viewBox="0 0 24 24" fill="none"
                                 stroke="#06B6D4" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                <rect x="1" y="4" width="22" height="16" rx="2" />
                                <line x1="1" y1="10" x2="23" y2="10" />
                            </svg>
                        </div>
                    </div>
                    <div class="text-muted small mb-1">Current Plan</div>
                    <div class="h5 fw-bold mb-0">
                        @(current?.PlanName ?? "Free")
                    </div>
                    @if (current != null)
                    {
                        <div class="small text-muted mt-1">
                            Renews @current.EndDate.ToString("MMM dd, yyyy")
                        </div>
                    }
                </div>
            </div>
        </div>

        <div class="col-md-3 col-sm-6">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-start mb-3">
                        <div class="rounded-3 p-2" style="background: rgba(16,185,129,.12);">
                            <svg width="20" height="20" viewBox="0 0 24 24" fill="none"
                                 stroke="#10B981" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                <path d="M12 2v20M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6" />
                            </svg>
                        </div>
                    </div>
                    <div class="text-muted small mb-1">Total Spent</div>
                    <div class="h5 fw-bold mb-0">৳@totalSpent.ToString("N2")</div>
                </div>
            </div>
        </div>

        <div class="col-md-3 col-sm-6">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-start mb-3">
                        <div class="rounded-3 p-2" style="background: rgba(59,130,246,.12);">
                            <svg width="20" height="20" viewBox="0 0 24 24" fill="none"
                                 stroke="#3B82F6" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                <path d="M9 5H7a2 2 0 0 0-2 2v12a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2V7a2 2 0 0 0-2-2h-2" />
                                <rect x="9" y="3" width="6" height="4" rx="1" />
                            </svg>
                        </div>
                    </div>
                    <div class="text-muted small mb-1">Total Payments</div>
                    <div class="h5 fw-bold mb-0">@paymentCount</div>
                </div>
            </div>
        </div>

        <div class="col-md-3 col-sm-6">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-start mb-3">
                        <div class="rounded-3 p-2" style="background: rgba(245,158,11,.12);">
                            <svg width="20" height="20" viewBox="0 0 24 24" fill="none"
                                 stroke="#F59E0B" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z" />
                                <polyline points="14 2 14 8 20 8" />
                            </svg>
                        </div>
                    </div>
                    <div class="text-muted small mb-1">Invoices</div>
                    <div class="h5 fw-bold mb-0">@recentInvoices.Count</div>
                </div>
            </div>
        </div>
    </div>

    <!-- ============================================================
         AVAILABLE PLANS
         ============================================================ -->
    <div class="card border-0 shadow-sm mb-4">
        <div class="card-body p-4">
            <div class="d-flex justify-content-between align-items-center mb-4">
                <div>
                    <h5 class="fw-bold mb-1">Available Plans</h5>
                    <p class="text-muted small mb-0">Choose a plan that fits your journey.</p>
                </div>
            </div>

            @if (plans.Any())
            {
                <div class="row g-3">
                    @foreach (var plan in plans)
                    {
                        var isCurrent = current != null && current.PlanId == plan.PlanId;
                        <div class="col-lg-4 col-md-6">
                            <div class="border rounded-4 p-4 h-100 position-relative @(isCurrent ? "border-primary" : "")">
                                @if (isCurrent)
                                {
                                    <span class="badge bg-primary position-absolute top-0 end-0 m-3">Current</span>
                                }
                                <h6 class="fw-bold mb-2">@plan.Name</h6>
                                <div class="mb-3">
                                    <span class="h3 fw-bold">৳@plan.Price.ToString("N0")</span>
                                    <span class="text-muted small"> / @plan.DurationDays days</span>
                                </div>
                                <p class="text-muted small mb-4">@plan.Description</p>

                                @if (isCurrent)
                                {
                                    <button class="btn btn-outline-primary w-100" disabled>
                                        Active Plan
                                    </button>
                                }
                                else
                                {
                                    <form asp-action="Subscribe" method="post">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="planId" value="@plan.PlanId" />
                                        <button type="submit" class="btn btn-primary w-100">
                                            @(current != null ? "Switch Plan" : "Subscribe")
                                        </button>
                                    </form>
                                }
                            </div>
                        </div>
                    }
                </div>
            }
            else
            {
                <div class="text-center py-5 text-muted">
                    <p class="mb-0">No plans available at the moment.</p>
                </div>
            }
        </div>
    </div>

    <!-- ============================================================
         RECENT PAYMENTS + RECENT INVOICES
         ============================================================ -->
    <div class="row g-3">
        <div class="col-lg-7">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-body p-4">
                    <div class="d-flex justify-content-between align-items-center mb-3">
                        <h6 class="fw-bold mb-0">Recent Payments</h6>
                        <a asp-action="History" class="btn btn-sm btn-link text-decoration-none">View all</a>
                    </div>

                    @if (recentPayments.Any())
                    {
                        <div class="table-responsive">
                            <table class="table table-hover align-middle mb-0">
                                <thead>
                                    <tr>
                                        <th class="text-muted small fw-normal">Date</th>
                                        <th class="text-muted small fw-normal">Amount</th>
                                        <th class="text-muted small fw-normal">Status</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var p in recentPayments)
                                    {
                                        <tr>
                                            <td class="small">@p.CreatedAt.ToString("MMM dd, yyyy")</td>
                                            <td class="small fw-semibold">৳@p.Amount.ToString("N2")</td>
                                            <td>
                                                @{
                                                    var badgeClass = p.Status switch
                                                    {
                                                        "Completed" => "bg-success",
                                                        "Pending" => "bg-warning",
                                                        "Failed" => "bg-danger",
                                                        _ => "bg-secondary"
                                                    };
                                                }
                                                <span class="badge @badgeClass">@p.Status</span>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                    else
                    {
                        <div class="text-center py-4 text-muted small">
                            No payments yet.
                        </div>
                    }
                </div>
            </div>
        </div>

        <div class="col-lg-5">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-body p-4">
                    <div class="d-flex justify-content-between align-items-center mb-3">
                        <h6 class="fw-bold mb-0">Recent Invoices</h6>
                        <a asp-action="Invoices" class="btn btn-sm btn-link text-decoration-none">View all</a>
                    </div>

                    @if (recentInvoices.Any())
                    {
                        <div class="list-group list-group-flush">
                            @foreach (var inv in recentInvoices)
                            {
                                <a asp-action="DownloadInvoice" asp-route-invoiceId="@inv.InvoiceId"
                                   class="list-group-item list-group-item-action d-flex justify-content-between align-items-center px-0">
                                    <div>
                                        <div class="small fw-semibold">@inv.InvoiceNumber</div>
                                        <div class="text-muted" style="font-size:0.75rem;">
                                            @inv.IssuedAt.ToString("MMM dd, yyyy")
                                        </div>
                                    </div>
                                    <div class="text-end">
                                        <div class="small fw-bold">৳@inv.Amount.ToString("N2")</div>
                                        <div class="text-primary" style="font-size:0.75rem;">Download ↓</div>
                                    </div>
                                </a>
                            }
                        </div>
                    }
                    else
                    {
                        <div class="text-center py-4 text-muted small">
                            No invoices yet.
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>

</div>