@model IReadOnlyList<Mindora.Application.DTOs.Payment.ConsultationPaymentDto>

@{
    ViewData["Title"] = "Consultation Payments";
}

<div class="container mt-4">
    <h2 class="fw-bold mb-4">Consultation Payments</h2>

    @if (Model.Count == 0)
    {
        <div class="alert alert-info">No consultation payments yet.</div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table payment-table table-hover align-middle">
                <thead class="table-light">
                    <tr>
                        <th>Date</th>
                        <th>Amount</th>
                        <th>Status</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var payment in Model)
                    {
                        <tr>
                            <td>@payment.CreatedAt.ToShortDateString()</td>
                            <td>@payment.Amount</td>
                            <td>
                                <span class="payment-badge @(payment.Status == "Completed" ? "bg-success" : payment.Status == "Pending" ? "bg-warning text-dark" : "bg-secondary") text-white">
                                    @payment.Status
                                </span>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>