@{
    ViewData["Title"] = "Admin Panel";
    var totalUsers = (int)(ViewBag.TotalUsers ?? 0);
    var totalPosts = (int)(ViewBag.TotalPosts ?? 0);
    var totalRevenue = (decimal)(ViewBag.TotalRevenue ?? 0m);
    var totalProfessionals = (int)(ViewBag.TotalProfessionals ?? 0);
    var pendingFlags = (int)(ViewBag.PendingFlags ?? 0);
    var pendingVerifications = (int)(ViewBag.PendingVerifications ?? 0);
    var recentUsers = ViewBag.RecentUsers as System.Collections.IEnumerable;
}

<div class="container-fluid py-4" style="max-width: 1400px;">

    <!-- ============================================================
         PAGE HEADER
         ============================================================ -->
    <div class="mindora-page-header">
        <div>
            <h1 class="mindora-page-title">Admin Panel</h1>
            <p class="mindora-page-subtitle">
                Central hub for managing the Mindora platform
            </p>
        </div>
        <div class="d-flex gap-2">
            <a asp-controller="AdminDashboard" asp-action="Index" class="btn btn-primary">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none"
                     stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"
                     style="vertical-align:-2px;margin-right:6px;">
                    <rect x="3" y="3" width="7" height="9" rx="1" />
                    <rect x="14" y="3" width="7" height="5" rx="1" />
                    <rect x="14" y="12" width="7" height="9" rx="1" />
                    <rect x="3" y="16" width="7" height="5" rx="1" />
                </svg>
                Live Dashboard
            </a>
        </div>
    </div>

    <!-- ============================================================
         QUICK STATS
         ============================================================ -->
    <div class="mindora-stat-grid">
        <div class="mindora-stat-card">
            <div class="mindora-stat-icon" style="background: rgba(6, 182, 212, 0.12); color: #06B6D4;">
                <svg width="22" height="22" viewBox="0 0 24 24" fill="none"
                     stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2" />
                    <circle cx="9" cy="7" r="4" />
                    <path d="M23 21v-2a4 4 0 0 0-3-3.87" />
                    <path d="M16 3.13a4 4 0 0 1 0 7.75" />
                </svg>
            </div>
            <div class="mindora-stat-value">@totalUsers.ToString("N0")</div>
            <div class="mindora-stat-label">Total Users</div>
        </div>

        <div class="mindora-stat-card">
            <div class="mindora-stat-icon" style="background: rgba(139, 92, 246, 0.12); color: #8B5CF6;">
                <svg width="22" height="22" viewBox="0 0 24 24" fill="none"
                     stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2" />
                    <circle cx="12" cy="7" r="4" />
                </svg>
            </div>
            <div class="mindora-stat-value">@totalProfessionals.ToString("N0")</div>
            <div class="mindora-stat-label">Professionals</div>
        </div>

        <div class="mindora-stat-card">
            <div class="mindora-stat-icon" style="background: rgba(245, 158, 11, 0.12); color: #F59E0B;">
                <svg width="22" height="22" viewBox="0 0 24 24" fill="none"
                     stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z" />
                </svg>
            </div>
            <div class="mindora-stat-value">@totalPosts.ToString("N0")</div>
            <div class="mindora-stat-label">Community Posts</div>
        </div>

        <div class="mindora-stat-card">
            <div class="mindora-stat-icon" style="background: rgba(16, 185, 129, 0.12); color: #10B981;">
                <svg width="22" height="22" viewBox="0 0 24 24" fill="none"
                     stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <line x1="12" y1="1" x2="12" y2="23" />
                    <path d="M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6" />
                </svg>
            </div>
            <div class="mindora-stat-value" style="font-size: 20px;">৳@totalRevenue.ToString("N0")</div>
            <div class="mindora-stat-label">Total Revenue</div>
        </div>
    </div>

    <!-- ============================================================
         ALERTS (Pending Items)
         ============================================================ -->
    @if (pendingFlags > 0 || pendingVerifications > 0)
    {
        <div class="row g-3 mb-4">
            @if (pendingFlags > 0)
            {
                <div class="col-md-6">
                    <a asp-controller="AdminModeration" asp-action="Index" class="admin-alert-card warning">
                        <div class="admin-alert-icon">
                            <svg width="22" height="22" viewBox="0 0 24 24" fill="none"
                                 stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                <path d="M10.29 3.86L1.82 18a2 2 0 0 0 1.71 3h16.94a2 2 0 0 0 1.71-3L13.71 3.86a2 2 0 0 0-3.42 0z" />
                                <line x1="12" y1="9" x2="12" y2="13" />
                                <line x1="12" y1="17" x2="12.01" y2="17" />
                            </svg>
                        </div>
                        <div>
                            <div class="admin-alert-count">@pendingFlags</div>
                            <div class="admin-alert-label">Pending Moderation Flags</div>
                        </div>
                        <svg class="admin-alert-arrow" width="20" height="20" viewBox="0 0 24 24" fill="none"
                             stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <polyline points="9 18 15 12 9 6" />
                        </svg>
                    </a>
                </div>
            }

            @if (pendingVerifications > 0)
            {
                <div class="col-md-6">
                    <a asp-controller="AdminProfessional" asp-action="Index" class="admin-alert-card info">
                        <div class="admin-alert-icon">
                            <svg width="22" height="22" viewBox="0 0 24 24" fill="none"
                                 stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                <path d="M12 2 4 6v6c0 5.55 3.84 10.74 8 12 4.16-1.26 8-6.45 8-12V6l-8-4z" />
                            </svg>
                        </div>
                        <div>
                            <div class="admin-alert-count">@pendingVerifications</div>
                            <div class="admin-alert-label">Pending Provider Verifications</div>
                        </div>
                        <svg class="admin-alert-arrow" width="20" height="20" viewBox="0 0 24 24" fill="none"
                             stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <polyline points="9 18 15 12 9 6" />
                        </svg>
                    </a>
                </div>
            }
        </div>
    }

    <!-- ============================================================
         ADMIN TOOLS GRID
         ============================================================ -->
    <div class="admin-tools-section">
        <h2 class="admin-tools-title">Admin Tools</h2>

        <div class="admin-tools-grid">

            <!-- Users -->
            <a asp-controller="AdminUser" asp-action="Index" class="admin-tool-card">
                <div class="admin-tool-icon" style="background: rgba(6, 182, 212, 0.12); color: #06B6D4;">
                    <svg width="24" height="24" viewBox="0 0 24 24" fill="none"
                         stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2" />
                        <circle cx="9" cy="7" r="4" />
                        <path d="M23 21v-2a4 4 0 0 0-3-3.87" />
                        <path d="M16 3.13a4 4 0 0 1 0 7.75" />
                    </svg>
                </div>
                <div class="admin-tool-content">
                    <h3>User Management</h3>
                    <p>View, edit, roles, deactivate accounts</p>
                </div>
            </a>

            <!-- Analytics -->
            <a asp-controller="AdminAnalytics" asp-action="Index" class="admin-tool-card">
                <div class="admin-tool-icon" style="background: rgba(139, 92, 246, 0.12); color: #8B5CF6;">
                    <svg width="24" height="24" viewBox="0 0 24 24" fill="none"
                         stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <line x1="18" y1="20" x2="18" y2="10" />
                        <line x1="12" y1="20" x2="12" y2="4" />
                        <line x1="6" y1="20" x2="6" y2="14" />
                    </svg>
                </div>
                <div class="admin-tool-content">
                    <h3>Analytics</h3>
                    <p>Platform metrics & insights</p>
                </div>
            </a>

            <!-- Moderation -->
            <a asp-controller="AdminModeration" asp-action="Index" class="admin-tool-card">
                <div class="admin-tool-icon" style="background: rgba(245, 158, 11, 0.12); color: #F59E0B;">
                    <svg width="24" height="24" viewBox="0 0 24 24" fill="none"
                         stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z" />
                    </svg>
                </div>
                <div class="admin-tool-content">
                    <h3>Moderation</h3>
                    <p>Review flags & content reports</p>
                </div>
            </a>

            <!-- Professionals -->
            <a asp-controller="AdminProfessional" asp-action="Index" class="admin-tool-card">
                <div class="admin-tool-icon" style="background: rgba(16, 185, 129, 0.12); color: #10B981;">
                    <svg width="24" height="24" viewBox="0 0 24 24" fill="none"
                         stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2" />
                        <circle cx="12" cy="7" r="4" />
                    </svg>
                </div>
                <div class="admin-tool-content">
                    <h3>Professionals</h3>
                    <p>Verify providers & licenses</p>
                </div>
            </a>

            <!-- Payments -->
            <a asp-controller="AdminPaymentManagement" asp-action="Index" class="admin-tool-card">
                <div class="admin-tool-icon" style="background: rgba(59, 130, 246, 0.12); color: #3B82F6;">
                    <svg width="24" height="24" viewBox="0 0 24 24" fill="none"
                         stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <rect x="1" y="4" width="22" height="16" rx="2" />
                        <line x1="1" y1="10" x2="23" y2="10" />
                    </svg>
                </div>
                <div class="admin-tool-content">
                    <h3>Payments</h3>
                    <p>Transactions, refunds, payouts</p>
                </div>
            </a>

            <!-- Reports -->
            <a asp-controller="Report" asp-action="Index" class="admin-tool-card">
                <div class="admin-tool-icon" style="background: rgba(236, 72, 153, 0.12); color: #EC4899;">
                    <svg width="24" height="24" viewBox="0 0 24 24" fill="none"
                         stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z" />
                        <polyline points="14 2 14 8 20 8" />
                        <line x1="16" y1="13" x2="8" y2="13" />
                        <line x1="16" y1="17" x2="8" y2="17" />
                    </svg>
                </div>
                <div class="admin-tool-content">
                    <h3>Reports</h3>
                    <p>Generate & export reports</p>
                </div>
            </a>

            <!-- Audit Log -->
            <a asp-controller="AdminAudit" asp-action="Index" class="admin-tool-card">
                <div class="admin-tool-icon" style="background: rgba(100, 116, 139, 0.12); color: #64748B;">
                    <svg width="24" height="24" viewBox="0 0 24 24" fill="none"
                         stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z" />
                        <circle cx="12" cy="13" r="2" />
                    </svg>
                </div>
                <div class="admin-tool-content">
                    <h3>Audit Log</h3>
                    <p>System & user activity trail</p>
                </div>
            </a>

            <!-- Notifications -->
            <a asp-controller="AdminNotificationManagement" asp-action="Index" class="admin-tool-card">
                <div class="admin-tool-icon" style="background: rgba(239, 68, 68, 0.12); color: #EF4444;">
                    <svg width="24" height="24" viewBox="0 0 24 24" fill="none"
                         stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M18 8a6 6 0 0 0-12 0c0 7-3 9-3 9h18c0-2-3-2-3-9" />
                        <path d="M10 21h4" />
                    </svg>
                </div>
                <div class="admin-tool-content">
                    <h3>Notifications</h3>
                    <p>Broadcast & templates</p>
                </div>
            </a>

            <!-- Content -->
            <a asp-controller="AdminContentManagement" asp-action="Index" class="admin-tool-card">
                <div class="admin-tool-icon" style="background: rgba(34, 211, 238, 0.12); color: #22D3EE;">
                    <svg width="24" height="24" viewBox="0 0 24 24" fill="none"
                         stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M4 19.5A2.5 2.5 0 0 1 6.5 17H20" />
                        <path d="M6.5 2H20v20H6.5A2.5 2.5 0 0 1 4 19.5v-15A2.5 2.5 0 0 1 6.5 2z" />
                    </svg>
                </div>
                <div class="admin-tool-content">
                    <h3>Content</h3>
                    <p>Wellness resources & categories</p>
                </div>
            </a>

            <!-- System Settings -->
            <a asp-controller="AdminSystemSettings" asp-action="Index" class="admin-tool-card">
                <div class="admin-tool-icon" style="background: rgba(148, 163, 184, 0.12); color: #94A3B8;">
                    <svg width="24" height="24" viewBox="0 0 24 24" fill="none"
                         stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <circle cx="12" cy="12" r="3" />
                        <path d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 0 1 0 2.83 2 2 0 0 1-2.83 0l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 0 1-2 2 2 2 0 0 1-2-2v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 0 1-2.83 0 2 2 0 0 1 0-2.83l.06-.06a1.65 1.65 0 0 0 .33-1.82 1.65 1.65 0 0 0-1.51-1H3a2 2 0 0 1-2-2 2 2 0 0 1 2-2h.09A1.65 1.65 0 0 0 4.6 9a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 0 1 0-2.83 2 2 0 0 1 2.83 0l.06.06a1.65 1.65 0 0 0 1.82.33H9a1.65 1.65 0 0 0 1-1.51V3a2 2 0 0 1 2-2 2 2 0 0 1 2 2v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 0 1 2.83 0 2 2 0 0 1 0 2.83l-.06.06a1.65 1.65 0 0 0-.33 1.82V9a1.65 1.65 0 0 0 1.51 1H21a2 2 0 0 1 2 2 2 2 0 0 1-2 2h-.09a1.65 1.65 0 0 0-1.51 1z" />
                    </svg>
                </div>
                <div class="admin-tool-content">
                    <h3>System Settings</h3>
                    <p>Platform configuration</p>
                </div>
            </a>

        </div>
    </div>

</div>