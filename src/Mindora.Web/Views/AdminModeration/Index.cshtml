@model IReadOnlyList<Mindora.Application.DTOs.AdminDashboard.AdminModerationFlagDto>

@{
    ViewData["Title"] = "Community Moderation";
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2 class="fw-bold">Pending Flags</h2>
        <a asp-action="History" class="btn btn-outline-secondary btn-sm">History</a>
    </div>

    @if (Model.Count == 0)
    {
        <div class="alert alert-info">No pending flags.</div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-hover align-middle">
                <thead class="table-light">
                    <tr>
                        <th>Type</th>
                        <th>Content</th>
                        <th>Reported By</th>
                        <th>Reason</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var flag in Model)
                    {
                        <tr>
                            <td>@flag.ContentType</td>
                            <td>@flag.ContentSnippet</td>
                            <td>@flag.ReportedByEmail</td>
                            <td>@flag.Reason</td>
                            <td>
                                <form asp-action="Approve" method="post" class="d-inline">
                                    <input type="hidden" name="flagId" value="@flag.FlagId" />
                                    <button type="submit" class="btn btn-sm btn-danger">Remove Content</button>
                                </form>
                                <form asp-action="Dismiss" method="post" class="d-inline">
                                    <input type="hidden" name="flagId" value="@flag.FlagId" />
                                    <button type="submit" class="btn btn-sm btn-success">Dismiss</button>
                                </form>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>