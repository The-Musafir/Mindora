@model IReadOnlyList<Mindora.Application.DTOs.AdminDashboard.AdminProfessionalDto>

@{
    ViewData["Title"] = "Professional Management";
    var searchTerm = ViewBag.SearchTerm as string;
}

<div class="container mt-4">
    <h2 class="fw-bold mb-4">Professional Management</h2>

    <form method="get" class="row g-2 mb-4">
        <div class="col-md-4">
            <input type="text" name="searchTerm" class="form-control" placeholder="Search by name, email, license..." value="@searchTerm" />
        </div>
        <div class="col-md-2">
            <button type="submit" class="btn btn-outline-primary w-100">Search</button>
        </div>
    </form>

    @if (Model.Count == 0)
    {
        <div class="alert alert-info">No professionals found.</div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-hover align-middle">
                <thead class="table-light">
                    <tr>
                        <th>Name</th>
                        <th>License</th>
                        <th>Experience</th>
                        <th>Verified</th>
                        <th>Status</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var pro in Model)
                    {
                        <tr>
                            <td>@pro.FullName</td>
                            <td>@pro.LicenseNumber</td>
                            <td>@pro.YearsOfExperience yrs</td>
                            <td>
                                <span class="badge @(pro.IsVerified ? "bg-success" : "bg-secondary")">
                                    @(pro.IsVerified ? "Verified" : "Unverified")
                                </span>
                            </td>
                            <td>
                                <span class="badge @(pro.IsActive ? "bg-primary" : "bg-danger")">
                                    @(pro.IsActive ? "Active" : "Suspended")
                                </span>
                            </td>
                            <td>
                                <a asp-action="Details" asp-route-id="@pro.ProviderId" class="btn btn-sm btn-outline-primary">Details</a>
                                <form asp-action="ToggleVerification" method="post" class="d-inline">
                                    <input type="hidden" name="providerId" value="@pro.ProviderId" />
                                    <button type="submit" name="isVerified" value="@(!pro.IsVerified)" class="btn btn-sm @(pro.IsVerified ? "btn-outline-secondary" : "btn-outline-success")">
                                        @(pro.IsVerified ? "Unverify" : "Verify")
                                    </button>
                                </form>
                                <form asp-action="ToggleActive" method="post" class="d-inline">
                                    <input type="hidden" name="providerId" value="@pro.ProviderId" />
                                    <button type="submit" name="isActive" value="@(!pro.IsActive)" class="btn btn-sm @(pro.IsActive ? "btn-outline-danger" : "btn-outline-primary")">
                                        @(pro.IsActive ? "Suspend" : "Activate")
                                    </button>
                                </form>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>