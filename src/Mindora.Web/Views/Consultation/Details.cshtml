@model Mindora.Application.DTOs.Consultation.ConsultationSessionDto

@{
    ViewData["Title"] = "Consultation Details";
    var notes = ViewBag.Notes as IReadOnlyList<Mindora.Application.DTOs.Consultation.ConsultationNoteDto>;
    var prescriptions = ViewBag.Prescriptions as IReadOnlyList<Mindora.Application.DTOs.Consultation.ConsultationPrescriptionDto>;
    var feedbacks = ViewBag.Feedbacks as IReadOnlyList<Mindora.Application.DTOs.Consultation.ConsultationFeedbackDto>;
    var followUpPlans = ViewBag.FollowUpPlans as IReadOnlyList<Mindora.Application.DTOs.Consultation.FollowUpPlanDto>;
    var reminders = ViewBag.Reminders as IReadOnlyList<Mindora.Application.DTOs.Consultation.ConsultationReminderDto>;
}

<div class="container mt-4" style="max-width: 1000px;">
    <nav aria-label="breadcrumb">
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a asp-action="Index">Consultations</a></li>
            <li class="breadcrumb-item active">Session</li>
        </ol>
    </nav>

    <div class="card consultation-card shadow-sm border-0 mb-4">
        <div class="card-body">
            <div class="d-flex flex-wrap justify-content-between align-items-start gap-3">
                <div>
                    <h2 class="fw-bold">@Model.ProviderName</h2>
                    <p class="text-muted mb-0">with @Model.UserName</p>
                </div>
                <span class="consultation-status-badge @(Model.Status == "Scheduled" ? "bg-primary" : Model.Status == "Completed" ? "bg-success" : Model.Status == "Cancelled" ? "bg-secondary" : "bg-danger") text-white">
                    @Model.Status
                </span>
            </div>

            <hr />

            <div class="row">
                <div class="col-md-6">
                    <p class="consultation-meta"><strong>Session Type:</strong> @Model.SessionType</p>
                    <p class="consultation-meta"><strong>Scheduled:</strong> @Model.ScheduledAt.ToString("f")</p>
                    <p class="consultation-meta"><strong>Started:</strong> @(Model.StartedAt?.ToString("f") ?? "Not started")</p>
                </div>
                <div class="col-md-6">
                    <p class="consultation-meta"><strong>Ended:</strong> @(Model.EndedAt?.ToString("f") ?? "Not ended")</p>
                    @if (!string.IsNullOrWhiteSpace(Model.MeetingLink))
                    {
                        <p class="consultation-meta"><strong>Meeting:</strong> <a href="@Model.MeetingLink" target="_blank">Join</a></p>
                    }
                    <p class="consultation-meta"><strong>Created:</strong> @Model.CreatedAt.ToString("f")</p>
                </div>
            </div>
        </div>
    </div>

    <!-- Status Update -->
    <div class="consultation-section">
        <h5>Update Status</h5>
        <form asp-action="UpdateStatus" method="post" class="row g-2">
            <input type="hidden" name="SessionId" value="@Model.SessionId" />
            <div class="col-md-3">
                <select name="Status" class="form-select">
                    <option value="Scheduled">Scheduled</option>
                    <option value="InProgress">In Progress</option>
                    <option value="Completed">Completed</option>
                    <option value="Cancelled">Cancelled</option>
                    <option value="NoShow">No Show</option>
                </select>
            </div>
            <div class="col-md-2">
                <button type="submit" class="btn btn-sm btn-primary w-100">Update</button>
            </div>
        </form>
    </div>

    <!-- Notes -->
    <div class="consultation-section">
        <h5>Notes</h5>
        @if (notes == null || notes.Count == 0)
        {
            <p class="text-muted">No notes yet.</p>
        }
        else
        {
            @foreach (var note in notes)
            {
                <p class="mb-1"><strong>@note.CreatedAt.ToString("g")</strong> - @note.Content</p>
            }
        }
        <form asp-action="AddNote" method="post">
            <input type="hidden" name="SessionId" value="@Model.SessionId" />
            <textarea name="Content" class="form-control mb-2" rows="2" placeholder="Add note..." required></textarea>
            <button type="submit" class="btn btn-sm btn-primary">Add Note</button>
        </form>
    </div>

    <!-- Prescriptions -->
    <div class="consultation-section">
        <h5>Prescriptions</h5>
        @if (prescriptions == null || prescriptions.Count == 0)
        {
            <p class="text-muted">No prescriptions yet.</p>
        }
        else
        {
            @foreach (var prescription in prescriptions)
            {
                <p class="mb-1"><strong>@prescription.CreatedAt.ToString("g")</strong> - @prescription.Content</p>
            }
        }
        <form asp-action="AddPrescription" method="post">
            <input type="hidden" name="SessionId" value="@Model.SessionId" />
            <textarea name="Content" class="form-control mb-2" rows="2" placeholder="Add prescription..." required></textarea>
            <button type="submit" class="btn btn-sm btn-primary">Add Prescription</button>
        </form>
    </div>

    <!-- Follow-up Plans -->
    <div class="consultation-section">
        <h5>Follow-up Plans</h5>
        @if (followUpPlans == null || followUpPlans.Count == 0)
        {
            <p class="text-muted">No follow-up plans yet.</p>
        }
        else
        {
            @foreach (var plan in followUpPlans)
            {
                <div class="d-flex justify-content-between align-items-center mb-2">
                    <span>@plan.Description</span>
                    <span class="badge @(plan.IsCompleted ? "bg-success" : "bg-warning text-dark")">
                        @(plan.IsCompleted ? "Completed" : "Pending")
                    </span>
                </div>
            }
        }
        <form asp-action="AddFollowUpPlan" method="post">
            <input type="hidden" name="SessionId" value="@Model.SessionId" />
            <textarea name="Description" class="form-control mb-2" rows="2" placeholder="Add follow-up plan..." required></textarea>
            <button type="submit" class="btn btn-sm btn-primary">Add Plan</button>
        </form>
    </div>

    <!-- Feedback -->
    <div class="consultation-section">
        <h5>Feedback</h5>
        @if (feedbacks == null || feedbacks.Count == 0)
        {
            <p class="text-muted">No feedback yet.</p>
        }
        else
        {
            @foreach (var feedback in feedbacks)
            {
                <div class="mb-2">
                    <span class="text-warning">@("★".PadRight(feedback.Rating, '★'))</span>
                    <strong>@feedback.UserName</strong> - @feedback.Comment
                </div>
            }
        }
        <form asp-action="AddFeedback" method="post">
            <input type="hidden" name="SessionId" value="@Model.SessionId" />
            <div class="row g-2">
                <div class="col-md-2">
                    <select name="Rating" class="form-select" required>
                        <option value="5">5</option>
                        <option value="4">4</option>
                        <option value="3">3</option>
                        <option value="2">2</option>
                        <option value="1">1</option>
                    </select>
                </div>
                <div class="col-md-7">
                    <textarea name="Comment" class="form-control" rows="1" placeholder="Share feedback..."></textarea>
                </div>
                <div class="col-md-3">
                    <button type="submit" class="btn btn-sm btn-primary w-100">Submit</button>
                </div>
            </div>
        </form>
    </div>

    <!-- Reminders -->
    <div class="consultation-section">
        <h5>Reminders</h5>
        @if (reminders == null || reminders.Count == 0)
        {
            <p class="text-muted">No reminders yet.</p>
        }
        else
        {
            @foreach (var reminder in reminders)
            {
                <p class="mb-1">@reminder.ReminderAt.ToString("f") - @reminder.Channel - @(reminder.IsSent ? "Sent" : "Pending")</p>
            }
        }
        <form asp-action="AddReminder" method="post" class="row g-2">
            <input type="hidden" name="SessionId" value="@Model.SessionId" />
            <div class="col-md-3">
                <input type="datetime-local" name="ReminderAt" class="form-control" required />
            </div>
            <div class="col-md-2">
                <select name="Channel" class="form-select">
                    <option value="InApp">In-App</option>
                    <option value="Email">Email</option>
                    <option value="Push">Push</option>
                </select>
            </div>
            <div class="col-md-2">
                <button type="submit" class="btn btn-sm btn-primary w-100">Add</button>
            </div>
        </form>
    </div>
</div>