@model IReadOnlyList<Mindora.Application.DTOs.Consultation.ConsultationSessionDto>

@{
    ViewData["Title"] = "My Consultations";
}

<div class="container mt-4">
    <div class="d-flex flex-wrap justify-content-between align-items-center mb-4 gap-2">
        <h2 class="fw-bold">Consultation Sessions</h2>
        <a asp-action="Create" class="btn btn-primary btn-sm">+ New Session</a>
    </div>

    @if (Model.Count == 0)
    {
        <div class="alert alert-info">No consultation sessions yet.</div>
    }
    else
    {
        <div class="row g-4">
            @foreach (var session in Model)
            {
                <div class="col-md-6 col-lg-4 d-flex">
                    <div class="card consultation-card h-100 shadow-sm border-0 w-100">
                        <div class="card-body d-flex flex-column">
                            <div class="d-flex justify-content-between align-items-start mb-2">
                                <h5 class="card-title fw-bold">@session.ProviderName</h5>
                                <span class="consultation-status-badge bg-primary text-white">@session.Status</span>
                            </div>

                            <p class="consultation-meta mb-1">
                                <strong>Session Type:</strong> @session.SessionType
                            </p>
                            <p class="consultation-meta mb-1">
                                <strong>Scheduled:</strong> @session.ScheduledAt.ToString("f")
                            </p>
                            <p class="text-muted small flex-grow-1">
                                @(session.Notes?.Length > 80 ? session.Notes.Substring(0, 80) + "..." : session.Notes)
                            </p>

                            <div class="d-flex flex-wrap gap-2 mt-auto">
                                <a asp-action="Details" asp-route-id="@session.SessionId" class="btn btn-sm btn-outline-primary">Details</a>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
</div>