@model Mindora.Application.DTOs.AI.AIWellnessCoachSessionDto
@{
    ViewData["Title"] = "AI Chat";
    var sessions = ViewBag.Sessions as IReadOnlyList<Mindora.Application.DTOs.AI.AIWellnessCoachSessionDto>
                   ?? new List<Mindora.Application.DTOs.AI.AIWellnessCoachSessionDto>();
    var activeId = (Guid?)ViewBag.ActiveSessionId ?? Model.SessionId;
}

<div class="chat-layout">

    <!-- ============================================================
         SIDEBAR
         ============================================================ -->
    <aside class="chat-sidebar" id="chatSidebar">

        <div class="chat-sidebar-header">
            <form asp-action="NewSession" method="post" class="w-100">
                @Html.AntiForgeryToken()
                <button type="submit" class="btn btn-primary w-100">
                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                         stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"
                         style="vertical-align:middle; margin-right:6px;">
                        <line x1="12" y1="5" x2="12" y2="19"></line>
                        <line x1="5" y1="12" x2="19" y2="12"></line>
                    </svg>
                    New Chat
                </button>
            </form>
        </div>

        <div class="chat-sidebar-list" id="sessionList">
            @if (!sessions.Any())
            {
                <div class="text-center text-muted small py-3">
                    No chats yet
                </div>
            }
            else
            {
                foreach (var s in sessions)
                {
                    var isActive = s.SessionId == activeId;
                    var title = GetSessionTitle(s);

                    <div class="chat-session-item @(isActive ? "active" : "")"
                         data-session-id="@s.SessionId"
                         data-session-title="@title">

                        <a asp-action="Session"
                           asp-route-id="@s.SessionId"
                           class="chat-session-link">
                            <div class="chat-session-title">@title</div>
                            <div class="chat-session-meta">
                                <span class="chat-session-date">@s.StartedAt.ToString("MMM dd, HH:mm")</span>
                                @if (s.MessageCount > 0)
                                {
                                    <span class="chat-session-count">@s.MessageCount msgs</span>
                                }
                            </div>
                        </a>

                        <div class="chat-session-menu">
                            <button type="button"
                                    class="chat-session-menu-btn"
                                    title="Options"
                                    data-session-id="@s.SessionId"
                                    data-session-title="@title">
                                <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                                    <circle cx="5" cy="12" r="2"></circle>
                                    <circle cx="12" cy="12" r="2"></circle>
                                    <circle cx="19" cy="12" r="2"></circle>
                                </svg>
                            </button>
                        </div>
                    </div>
                }
            }
        </div>

    </aside>

    <!-- ============================================================
         MAIN CHAT AREA
         ============================================================ -->
    <main class="chat-main">

        <div class="chat-main-header">
            <button class="btn btn-sm btn-outline-secondary d-lg-none" id="toggleSidebar">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                     stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <line x1="3" y1="6" x2="21" y2="6"></line>
                    <line x1="3" y1="12" x2="21" y2="12"></line>
                    <line x1="3" y1="18" x2="21" y2="18"></line>
                </svg>
            </button>
            <div class="chat-main-title">
                <strong>Mindora AI Coach</strong>
            </div>
        </div>

        <div class="chat-container" id="chatContainer">
            <div id="chatMessages">
                @if (Model.Messages != null && Model.Messages.Any())
                {
                    foreach (var msg in Model.Messages)
                    {
                        var isUser = msg.Sender == "User";
                        <div class="chat-message @(isUser ? "chat-user" : "chat-ai")">
                            <div class="chat-bubble">
                                <div class="chat-text">@msg.Content</div>
                                <div class="chat-time">@msg.SentAt.ToString("HH:mm")</div>
                            </div>
                        </div>
                    }
                }
                else
                {
                    <div class="chat-empty-state" id="emptyState">
                        <svg width="64" height="64" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                             stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"
                             style="opacity:.25; margin-bottom:16px;">
                            <path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"></path>
                        </svg>
                        <h5>How can I help you today?</h5>
                        <p class="text-muted small">Ask about habits, wellness, stress, or anything on your mind.</p>
                    </div>
                }
            </div>

            <div id="streamingIndicator" class="chat-message chat-ai d-none">
                <div class="chat-bubble">
                    <div class="chat-text">
                        <span id="streamingText"></span><span class="cursor-blink">▋</span>
                    </div>
                </div>
            </div>
        </div>

        <div class="chat-input-area">
            <form id="chatForm" class="d-flex gap-2">
                <input type="text"
                       id="messageInput"
                       class="form-control"
                       placeholder="Message Mindora AI..."
                       autocomplete="off"
                       maxlength="2000" />
                <button type="submit" class="btn btn-primary" id="sendBtn">
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                         stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <line x1="22" y1="2" x2="11" y2="13"></line>
                        <polygon points="22 2 15 22 11 13 2 9 22 2"></polygon>
                    </svg>
                </button>
                <button type="button" class="btn btn-danger d-none" id="stopBtn">
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor">
                        <rect x="6" y="6" width="12" height="12" rx="2"></rect>
                    </svg>
                </button>
            </form>
        </div>

    </main>

</div>

<!-- ============================================================
     CONTEXT MENU (hidden by default)
     ============================================================ -->
<div id="sessionContextMenu" class="session-context-menu d-none">
    <button type="button" class="session-context-item" data-action="rename">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor"
             stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M12 20h9"></path>
            <path d="M16.5 3.5a2.121 2.121 0 0 1 3 3L7 19l-4 1 1-4L16.5 3.5z"></path>
        </svg>
        Rename
    </button>
    <button type="button" class="session-context-item text-danger" data-action="delete">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor"
             stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <polyline points="3 6 5 6 21 6"></polyline>
            <path d="M19 6l-2 14a2 2 0 0 1-2 2H9a2 2 0 0 1-2-2L5 6"></path>
            <path d="M10 11v6"></path>
            <path d="M14 11v6"></path>
            <path d="M9 6V4a1 1 0 0 1 1-1h4a1 1 0 0 1 1 1v2"></path>
        </svg>
        Delete
    </button>
</div>

<input type="hidden" id="sessionId" value="@Model.SessionId" />

<script src="~/js/chat.js" asp-append-version="true"></script>

@functions {
    string GetSessionTitle(Mindora.Application.DTOs.AI.AIWellnessCoachSessionDto s)
    {
        var firstUserMsg = s.Messages?.FirstOrDefault(m => m.Sender == "User");
        if (firstUserMsg != null && !string.IsNullOrWhiteSpace(firstUserMsg.Content))
        {
            var text = firstUserMsg.Content.Trim();
            return text.Length > 40 ? text.Substring(0, 40) + "…" : text;
        }

        if (s.StartedAt.Date == DateTime.UtcNow.Date)
            return "New Chat";

        return $"Chat — {s.StartedAt:MMM dd}";
    }
}