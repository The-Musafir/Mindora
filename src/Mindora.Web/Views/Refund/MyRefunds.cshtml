@model IReadOnlyList<Mindora.Application.DTOs.Payment.RefundRequestDto>

@{
    ViewData["Title"] = "My Refund Requests";
}

<div class="container mt-4">
    <h2 class="fw-bold mb-4">My Refund Requests</h2>

    @if (Model.Count == 0)
    {
        <div class="alert alert-info">No refund requests.</div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-hover align-middle">
                <thead class="table-light">
                    <tr>
                        <th>Date</th>
                        <th>Amount</th>
                        <th>Reason</th>
                        <th>Status</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var refund in Model)
                    {
                        <tr>
                            <td>@refund.CreatedAt.ToShortDateString()</td>
                            <td>@refund.Amount</td>
                            <td>@refund.Reason</td>
                            <td>
                                <span class="badge @(refund.Status == "Approved" ? "bg-success" : refund.Status == "Rejected" ? "bg-danger" : "bg-warning text-dark")">
                                    @refund.Status
                                </span>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>