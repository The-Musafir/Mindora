@model IReadOnlyList<Mindora.Application.DTOs.Reporting.GeneratedReportDto>

@{
    ViewData["Title"] = "My Reports";
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2 class="fw-bold">My Reports</h2>
        <a asp-action="Create" class="btn btn-primary btn-sm">+ New Report</a>
    </div>

    @if (Model.Count == 0)
    {
        <div class="alert alert-info">No reports yet. Click "New Report" to generate one.</div>
    }
    else
    {
        <div class="reporting-card shadow-sm">
            <div class="table-responsive">
                <table class="table reporting-table table-hover align-middle">
                    <thead class="table-light">
                        <tr>
                            <th>Type</th>
                            <th>Format</th>
                            <th>Status</th>
                            <th>Requested</th>
                            <th>Completed</th>
                            <th></th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var report in Model)
                        {
                            <tr>
                                <td>@report.ReportType</td>
                                <td>@report.Format</td>
                                <td>
                                    <span class="reporting-badge @(report.Status == "Completed" ? "bg-success text-white" : report.Status == "Failed" ? "bg-danger text-white" : "bg-warning text-dark")">
                                        @report.Status
                                    </span>
                                </td>
                                <td>@report.RequestedAt.ToString("g")</td>
                                <td>@(report.CompletedAt?.ToString("g") ?? "-")</td>
                                <td>
                                    @if (report.Status == "Completed")
                                    {
                                        <a asp-action="Download" asp-route-id="@report.GeneratedReportId"
                                           class="btn btn-sm btn-outline-primary">Download</a>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }
</div>