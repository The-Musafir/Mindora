@model IReadOnlyList<Mindora.Application.DTOs.Payment.CouponDto>

@{
    ViewData["Title"] = "Coupons";
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2 class="fw-bold">Coupon Management</h2>
        <a asp-action="Create" class="btn btn-primary btn-sm">+ New Coupon</a>
    </div>

    @if (Model.Count == 0)
    {
        <div class="alert alert-info">No coupons yet.</div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-hover align-middle">
                <thead class="table-light">
                    <tr>
                        <th>Code</th>
                        <th>Type</th>
                        <th>Value</th>
                        <th>Usage</th>
                        <th>Status</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var coupon in Model)
                    {
                        <tr>
                            <td><code>@coupon.Code</code></td>
                            <td>@coupon.DiscountType</td>
                            <td>@coupon.DiscountValue</td>
                            <td>@coupon.UsageCount / @coupon.UsageLimit</td>
                            <td>
                                <span class="badge @(coupon.IsActive ? "bg-success" : "bg-secondary")">
                                    @(coupon.IsActive ? "Active" : "Inactive")
                                </span>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>