@model Mindora.Application.DTOs.Profile.ProfileViewModel

<div class="profile-header">

    <!-- Avatar -->
    <div class="profile-avatar-wrapper">
        @if (!string.IsNullOrEmpty(Model.AvatarUrl))
        {
            <img src="@Model.AvatarUrl" alt="@Model.DisplayName" class="profile-avatar-img" />
        }
        else
        {
            <div class="profile-avatar-initial">@Model.Initial</div>
        }

        <!-- Edit overlay -->
        <label for="avatarInput" class="profile-avatar-edit" title="Change photo">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none"
                 stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M23 19a2 2 0 0 1-2 2H3a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h4l2-3h6l2 3h4a2 2 0 0 1 2 2z" />
                <circle cx="12" cy="13" r="4" />
            </svg>
        </label>
    </div>

    <!-- Info -->
    <div class="profile-header-info">
        <h1 class="profile-name">@Model.DisplayName</h1>

        <div class="profile-badges">
            <span class="profile-role-badge" style="background: @Model.RoleBadgeColor;">
                @Model.PrimaryRole
            </span>
            <span class="profile-member-since">
                Member since @Model.CreatedAt.ToString("MMM yyyy")
            </span>
        </div>

        @if (!string.IsNullOrEmpty(Model.Bio))
        {
            <p class="profile-bio-preview">
                @(Model.Bio.Length > 160 ? Model.Bio.Substring(0, 160) + "..." : Model.Bio)
            </p>
        }
    </div>

</div>