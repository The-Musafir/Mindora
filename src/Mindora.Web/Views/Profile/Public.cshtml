@model Mindora.Application.DTOs.Profile.PublicProfileViewModel
@{
    ViewData["Title"] = Model.DisplayName;
}

<div class="profile-page">

    <!-- ============================================================
         PROFILE HEADER CARD
         ============================================================ -->
    <div class="profile-card">
        <div class="profile-header">

            <!-- Avatar -->
            <div class="profile-avatar-wrapper">
                @if (!string.IsNullOrEmpty(Model.AvatarUrl))
                {
                    <img src="@Model.AvatarUrl" alt="@Model.DisplayName" class="profile-avatar-img" />
                }
                else
                {
                    <div class="profile-avatar-initial">@Model.Initial</div>
                }
            </div>

            <!-- Info -->
            <div class="profile-header-info">
                <h1 class="profile-name">@Model.DisplayName</h1>

                <div class="profile-badges">
                    <span class="profile-role-badge" style="background: @Model.RoleBadgeColor;">
                        @Model.PrimaryRole
                    </span>
                    <span class="profile-member-since">
                        Member since @Model.MemberSince.ToString("MMM yyyy")
                    </span>
                </div>

                <!-- Follow stats -->
                <div class="profile-follow-stats">
                    <a asp-action="Followers" asp-route-id="@Model.UserId" class="profile-follow-stat-link">
                        <strong id="followerCountDisplay">@Model.FollowerCount</strong>
                        <span>@(Model.FollowerCount == 1 ? "Follower" : "Followers")</span>
                    </a>
                    <span class="profile-follow-dot">·</span>
                    <a asp-action="Following" asp-route-id="@Model.UserId" class="profile-follow-stat-link">
                        <strong>@Model.FollowingCount</strong>
                        <span>Following</span>
                    </a>
                </div>

                <!-- Follow button (if not own profile) -->
                @if (!Model.IsOwnProfile)
                {
                    @if (Model.IsAuthenticated)
                    {
                        <form method="post"
                              asp-controller="Follow"
                              asp-action="Toggle"
                              asp-route-userId="@Model.UserId"
                              class="profile-follow-form"
                              id="followForm">
                            @Html.AntiForgeryToken()
                            <button type="submit"
                                    id="followBtn"
                                    class="profile-follow-btn @(Model.IsFollowing ? "following" : "")"
                                    data-following="@Model.IsFollowing.ToString().ToLower()">
                                <span class="follow-btn-text">
                                    @(Model.IsFollowing ? "Following" : "Follow")
                                </span>
                            </button>
                        </form>
                    }
                    else
                    {
                        <a asp-area="Identity" asp-page="/Account/Login"
                           class="profile-follow-btn guest">
                            Follow
                        </a>
                    }
                }

                @if (!string.IsNullOrEmpty(Model.Bio))
                {
                    <p class="profile-bio-preview">@Model.Bio</p>
                }
                else
                {
                    <p class="profile-bio-preview text-muted fst-italic">
                        This user hasn't added a bio yet.
                    </p>
                }
            </div>

        </div>

        <!-- Owner: Edit Button -->
        @if (Model.IsOwnProfile)
        {
            <div class="profile-public-actions">
                <a asp-controller="Profile" asp-action="Index" class="profile-btn-primary">
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none"
                         stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"
                         style="vertical-align:-2px;margin-right:6px;">
                        <path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7" />
                        <path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z" />
                    </svg>
                    Edit My Profile
                </a>
            </div>
        }
    </div>

    <!-- ============================================================
         STATS CARDS
         ============================================================ -->
    <div class="profile-public-stats">
        <div class="profile-stat-card">
            <div class="profile-stat-icon" style="background: rgba(6, 182, 212, 0.1); color: #06B6D4;">
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none"
                     stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M4 19.5A2.5 2.5 0 0 1 6.5 17H20" />
                    <path d="M6.5 2H20v20H6.5A2.5 2.5 0 0 1 4 19.5v-15A2.5 2.5 0 0 1 6.5 2z" />
                </svg>
            </div>
            <div class="profile-stat-value">@Model.TotalPosts</div>
            <div class="profile-stat-label">Community Posts</div>
        </div>

        <div class="profile-stat-card">
            <div class="profile-stat-icon" style="background: rgba(139, 92, 246, 0.1); color: #8B5CF6;">
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none"
                     stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2" />
                </svg>
            </div>
            <div class="profile-stat-value">@Model.TotalReviews</div>
            <div class="profile-stat-label">Reviews Given</div>
        </div>

        @if (Model.AverageRatingGiven.HasValue)
        {
            <div class="profile-stat-card">
                <div class="profile-stat-icon" style="background: rgba(245, 158, 11, 0.1); color: #F59E0B;">
                    <svg width="20" height="20" viewBox="0 0 24 24" fill="none"
                         stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2" />
                    </svg>
                </div>
                <div class="profile-stat-value">@Model.AverageRatingGiven.Value.ToString("F1")</div>
                <div class="profile-stat-label">Avg. Rating Given</div>
            </div>
        }
    </div>

    <!-- ============================================================
         ACTIVITY SECTION
         ============================================================ -->
    @if (Model.HasActivity)
    {
        <div class="profile-card">
            <div class="profile-section-header">
                <h2>Recent Activity</h2>
                <p class="profile-section-subtitle">
                    Public contributions from @Model.DisplayName
                </p>
            </div>

            <!-- RECENT POSTS -->
            @if (Model.RecentPosts.Any())
            {
                <div class="profile-activity-section">
                    <h3 class="profile-activity-title">
                        <svg width="18" height="18" viewBox="0 0 24 24" fill="none"
                             stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"
                             style="vertical-align:-3px;margin-right:6px;">
                            <path d="M4 19.5A2.5 2.5 0 0 1 6.5 17H20" />
                            <path d="M6.5 2H20v20H6.5A2.5 2.5 0 0 1 4 19.5v-15A2.5 2.5 0 0 1 6.5 2z" />
                        </svg>
                        Community Posts
                    </h3>

                    <div class="profile-activity-list">
                        @foreach (var post in Model.RecentPosts)
                        {
                            <a asp-controller="Community"
                               asp-action="Details"
                               asp-route-id="@post.PostId"
                               class="profile-activity-item">
                                <div class="profile-activity-item-header">
                                    <div class="profile-activity-item-title">@post.Title</div>
                                    @if (!string.IsNullOrEmpty(post.Category))
                                    {
                                        <span class="profile-activity-badge">@post.Category</span>
                                    }
                                </div>
                                @if (!string.IsNullOrEmpty(post.BodyPreview))
                                {
                                    <p class="profile-activity-item-preview">@post.BodyPreview</p>
                                }
                                <div class="profile-activity-item-meta">
                                    <span>
                                        <svg width="12" height="12" viewBox="0 0 24 24" fill="none"
                                             stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                            <path d="M14 9V5a3 3 0 0 0-3-3l-4 9v11h11.28a2 2 0 0 0 2-1.7l1.38-9a2 2 0 0 0-2-2.3zM7 22H4a2 2 0 0 1-2-2v-7a2 2 0 0 1 2-2h3" />
                                        </svg>
                                        @post.LikeCount
                                    </span>
                                    <span>
                                        <svg width="12" height="12" viewBox="0 0 24 24" fill="none"
                                             stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                            <path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z" />
                                        </svg>
                                        @post.CommentCount
                                    </span>
                                    <span class="profile-activity-date">
                                        @post.CreatedAt.ToString("MMM dd, yyyy")
                                    </span>
                                </div>
                            </a>
                        }
                    </div>
                </div>
            }

            <!-- RECENT REVIEWS -->
            @if (Model.RecentReviews.Any())
            {
                <div class="profile-activity-section">
                    <h3 class="profile-activity-title">
                        <svg width="18" height="18" viewBox="0 0 24 24" fill="none"
                             stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"
                             style="vertical-align:-3px;margin-right:6px;">
                            <polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2" />
                        </svg>
                        Reviews Given
                    </h3>

                    <div class="profile-activity-list">
                        @foreach (var review in Model.RecentReviews)
                        {
                            <div class="profile-activity-item profile-activity-review">
                                <div class="profile-activity-item-header">
                                    <div class="profile-review-stars">
                                        @for (int i = 1; i <= 5; i++)
                                        {
                                            <span class="@(i <= review.Rating ? "star-filled" : "star-empty")">★</span>
                                        }
                                    </div>
                                    <span class="profile-activity-date">
                                        @review.CreatedAt.ToString("MMM dd, yyyy")
                                    </span>
                                </div>
                                <div class="profile-activity-review-provider">
                                    For <strong>@review.ProviderName</strong>
                                </div>
                                @if (!string.IsNullOrEmpty(review.Comment))
                                {
                                    <p class="profile-activity-item-preview">"@review.Comment"</p>
                                }
                            </div>
                        }
                    </div>
                </div>
            }
        </div>
    }
    else
    {
        <!-- Empty activity state -->
        <div class="profile-card">
            <div class="profile-empty-activity">
                <svg width="48" height="48" viewBox="0 0 24 24" fill="none"
                     stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"
                     style="opacity: 0.3; margin-bottom: 12px;">
                    <path d="M4 19.5A2.5 2.5 0 0 1 6.5 17H20" />
                    <path d="M6.5 2H20v20H6.5A2.5 2.5 0 0 1 4 19.5v-15A2.5 2.5 0 0 1 6.5 2z" />
                </svg>
                <p class="text-muted mb-0">
                    No public activity yet.
                </p>
            </div>
        </div>
    }

</div>