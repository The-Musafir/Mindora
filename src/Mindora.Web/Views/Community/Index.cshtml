@using System.Security.Claims
@model IReadOnlyList<Mindora.Application.DTOs.Community.PostResponse>

@{
    ViewData["Title"] = "Community";
    var groups = ViewBag.Groups as IReadOnlyList<Mindora.Application.DTOs.Community.GroupResponse>;
    var currentUserIdStr = User.FindFirst(ClaimTypes.NameIdentifier)?.Value;
    Guid? currentUserId = Guid.TryParse(currentUserIdStr, out var uid) ? uid : null;
}

<div class="container mt-4">
    <div class="d-flex flex-wrap justify-content-between align-items-center mb-4 gap-2">
        <h2 class="fw-bold">Community Feed</h2>
        <div class="d-flex gap-2">
            <a asp-action="Groups" class="btn btn-outline-secondary btn-sm">Groups</a>
            <a asp-action="Create" class="btn btn-primary btn-sm">+ New Post</a>
        </div>
    </div>

    @if (Model == null || Model.Count == 0)
    {
        <div class="alert alert-info">No posts yet. Be the first to share something supportive!</div>
    }
    else
    {
        <div class="row g-4">
            @foreach (var post in Model)
            {
                <div class="col-md-6 col-lg-4 d-flex">
                    <div class="card community-card h-100 shadow-sm border-0 w-100">
                        <div class="card-body d-flex flex-column">
                            @if (post.IsPinned)
                            {
                                <span class="community-feed-badge bg-warning text-dark align-self-start mb-2">📌 Pinned</span>
                            }

                            <h5 class="card-title">@post.Title</h5>

                            <p class="text-muted small flex-grow-1">
                                @(post.Body.Length > 150 ? post.Body.Substring(0, 150) + "..." : post.Body)
                            </p>

                            <div class="d-flex justify-content-between align-items-center mb-3">
                                @if (!post.IsAnonymous)
                                {
                                    <a href="/u/@post.UserId"
                                       class="community-feed-badge bg-primary text-white text-decoration-none community-author-link"
                                       title="View @post.AuthorName's profile">
                                        @post.AuthorName
                                    </a>
                                }
                                else
                                {
                                    <span class="community-feed-badge bg-secondary text-white">
                                        Anonymous
                                    </span>
                                }

                                <span class="text-muted small">@post.CreatedAt.ToShortDateString()</span>
                            </div>

                            <div class="d-flex flex-wrap gap-2 mt-auto">
                                <a asp-action="Details" asp-route-id="@post.PostId" class="btn btn-sm btn-outline-primary">
                                    Details
                                </a>

                                @if (currentUserId.HasValue && post.UserId == currentUserId.Value)
                                {
                                    <a asp-action="Edit" asp-route-id="@post.PostId" class="btn btn-sm btn-outline-secondary">
                                        Edit
                                    </a>
                                    <form asp-action="Delete" asp-route-id="@post.PostId" method="post" class="d-inline">
                                        @Html.AntiForgeryToken()
                                        <button type="submit" class="btn btn-sm btn-outline-danger">Delete</button>
                                    </form>
                                }
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
</div>