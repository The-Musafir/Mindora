@model Mindora.Application.DTOs.Community.CreatePostRequest

@{
    ViewData["Title"] = "Create Post";
    var groups = ViewBag.Groups as IReadOnlyList<Mindora.Application.DTOs.Community.GroupResponse>;
}

<div class="container mt-4" style="max-width: 700px;">
    <h2 class="fw-bold mb-4">Create New Post</h2>

    <form asp-action="Create" method="post">
        <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

        <div class="mb-3">
            <label asp-for="Title" class="form-label"></label>
            <input asp-for="Title" class="form-control" />
            <span asp-validation-for="Title" class="text-danger"></span>
        </div>

        <div class="mb-3">
            <label asp-for="Body" class="form-label"></label>
            <textarea asp-for="Body" class="form-control" rows="8"></textarea>
            <span asp-validation-for="Body" class="text-danger"></span>
        </div>

        <div class="row">
            <div class="col-md-6 mb-3">
                <label asp-for="Category" class="form-label"></label>
                <input asp-for="Category" class="form-control" placeholder="e.g., Support, Motivation" />
            </div>
            <div class="col-md-6 mb-3">
                <label asp-for="GroupId" class="form-label">Group</label>
                <select asp-for="GroupId" class="form-select">
                    <option value="">-- Select Group --</option>
                    @if (groups != null)
                    {
                        @foreach (var group in groups)
                        {
                            <option value="@group.GroupId">@group.Name</option>
                        }
                    }
                </select>
            </div>
        </div>

        <div class="form-check mb-3">
            <input asp-for="IsAnonymous" class="form-check-input" type="checkbox" />
            <label asp-for="IsAnonymous" class="form-check-label">Post Anonymously</label>
        </div>

        <button type="submit" class="btn btn-primary">Post</button>
        <a asp-action="Index" class="btn btn-outline-secondary">Cancel</a>
    </form>
</div>