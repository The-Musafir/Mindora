@model Mindora.Application.DTOs.Community.CreateGroupRequest

@{
    ViewData["Title"] = "Create Group";
}

<div class="container mt-4" style="max-width: 600px;">
    <h2 class="fw-bold mb-4">Create Support Group</h2>

    <form asp-action="CreateGroup" method="post">
        <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

        <div class="mb-3">
            <label asp-for="Name" class="form-label"></label>
            <input asp-for="Name" class="form-control" />
            <span asp-validation-for="Name" class="text-danger"></span>
        </div>

        <div class="mb-3">
            <label asp-for="Description" class="form-label"></label>
            <textarea asp-for="Description" class="form-control" rows="4"></textarea>
        </div>

        <button type="submit" class="btn btn-primary">Create Group</button>
        <a asp-action="Groups" class="btn btn-outline-secondary">Cancel</a>
    </form>
</div>