@model IReadOnlyList<Mindora.Application.DTOs.Community.GroupResponse>

@{
    ViewData["Title"] = "Community Groups";
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2 class="fw-bold">Support Groups</h2>
        <a asp-action="CreateGroup" class="btn btn-primary btn-sm">+ New Group</a>
    </div>

    @if (Model.Count == 0)
    {
        <div class="alert alert-info">No groups yet. Create one!</div>
    }
    else
    {
        <div class="row g-4">
            @foreach (var group in Model)
            {
                <div class="col-md-6 col-lg-4 d-flex">
                    <div class="card community-card h-100 shadow-sm border-0 w-100">
                        <div class="card-body d-flex flex-column">
                            <h5 class="card-title">@group.Name</h5>
                            <p class="text-muted small flex-grow-1">@group.Description</p>
                            <div class="d-flex justify-content-between align-items-center">
                                <span class="text-muted small">@group.MemberCount Members</span>
                                <span class="text-muted small">@group.PostCount Posts</span>
                            </div>
                            <div class="mt-2">
                                <a asp-action="Group" asp-route-id="@group.GroupId" class="btn btn-sm btn-outline-primary">View Group</a>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
</div>