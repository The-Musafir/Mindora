@model IReadOnlyList<Mindora.Application.DTOs.Reporting.ReportRecipientDto>

@{
    ViewData["Title"] = "Report Recipients";
    var scheduledReportId = ViewBag.ScheduledReportId as Guid?;
    var reportType = ViewBag.ReportType as string;
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="fw-bold">Recipients</h2>
            <p class="text-muted mb-0">Report Type: <strong>@reportType</strong></p>
        </div>
        <a asp-controller="ScheduledReport" asp-action="Index" class="btn btn-outline-secondary btn-sm">Back to Schedules</a>
    </div>

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger">@TempData["Error"]</div>
    }

    <!-- Add Recipient -->
    <div class="reporting-card shadow-sm mb-4">
        <div class="reporting-card-title">Add Recipient</div>
        <form asp-action="Add" method="post" class="row g-2">
            @Html.AntiForgeryToken()
            <input type="hidden" name="ScheduledReportId" value="@scheduledReportId" />
            <div class="col-md-5">
                <input name="UserId" class="form-control" placeholder="User Id (GUID)" required />
            </div>
            <div class="col-md-3">
                <select name="DeliveryChannel" class="form-select">
                    <option value="Email">Email</option>
                    <option value="InApp">In-App</option>
                </select>
            </div>
            <div class="col-md-2">
                <button type="submit" class="btn btn-primary w-100">Add</button>
            </div>
        </form>
    </div>

    <!-- Recipient List -->
    <div class="reporting-card shadow-sm">
        <div class="reporting-card-title">Current Recipients</div>

        @if (Model.Count == 0)
        {
            <div class="alert alert-info mb-0">No recipients added yet.</div>
        }
        else
        {
            <div class="table-responsive">
                <table class="table reporting-table table-hover align-middle">
                    <thead class="table-light">
                        <tr>
                            <th>Email</th>
                            <th>Channel</th>
                            <th>Added At</th>
                            <th></th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var r in Model)
                        {
                            <tr>
                                <td>@r.UserEmail</td>
                                <td>@r.DeliveryChannel</td>
                                <td>@r.AddedAt.ToString("g")</td>
                                <td>
                                    <form asp-action="Remove" method="post" class="d-inline">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="reportRecipientId" value="@r.ReportRecipientId" />
                                        <input type="hidden" name="scheduledReportId" value="@scheduledReportId" />
                                        <button type="submit" class="btn btn-sm btn-outline-danger">Remove</button>
                                    </form>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            <form asp-action="RemoveAll" method="post" class="mt-3">
                @Html.AntiForgeryToken()
                <input type="hidden" name="scheduledReportId" value="@scheduledReportId" />
                <button type="submit" class="btn btn-sm btn-outline-danger">Remove All</button>
            </form>
        }
    </div>
</div>