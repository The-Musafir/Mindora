@model Mindora.Application.DTOs.Journal.JournalStatisticsViewModel
@{
    ViewData["Title"] = "Journal Statistics";
}

<div class="container-fluid py-4" style="max-width: 1200px;">

    <!-- PAGE HEADER -->
    <div class="mindora-page-header">
        <div>
            <h1 class="mindora-page-title">Journal Insights</h1>
            <p class="mindora-page-subtitle">Your writing and mood trends</p>
        </div>
        <div class="d-flex gap-2">
            <a asp-action="Create" class="btn btn-primary">
                + New Entry
            </a>
            <a asp-action="Index" class="btn btn-outline-secondary">
                All Entries
            </a>
        </div>
    </div>

    <!-- STAT CARDS -->
    <div class="mindora-stat-grid">
        <div class="mindora-stat-card">
            <div class="mindora-stat-icon" style="background: rgba(6, 182, 212, 0.12); color: #06B6D4;">
                <svg width="22" height="22" viewBox="0 0 24 24" fill="none"
                     stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M4 19.5A2.5 2.5 0 0 1 6.5 17H20" />
                    <path d="M6.5 2H20v20H6.5A2.5 2.5 0 0 1 4 19.5v-15A2.5 2.5 0 0 1 6.5 2z" />
                </svg>
            </div>
            <div class="mindora-stat-value">@Model.TotalEntries</div>
            <div class="mindora-stat-label">Total Entries</div>
        </div>

        <div class="mindora-stat-card">
            <div class="mindora-stat-icon" style="background: rgba(139, 92, 246, 0.12); color: #8B5CF6;">
                <svg width="22" height="22" viewBox="0 0 24 24" fill="none"
                     stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <rect x="3" y="4" width="18" height="18" rx="2" ry="2" />
                    <line x1="16" y1="2" x2="16" y2="6" />
                    <line x1="8" y1="2" x2="8" y2="6" />
                    <line x1="3" y1="10" x2="21" y2="10" />
                </svg>
            </div>
            <div class="mindora-stat-value">@Model.EntriesThisMonth</div>
            <div class="mindora-stat-label">This Month</div>
        </div>

        <div class="mindora-stat-card">
            <div class="mindora-stat-icon" style="background: rgba(245, 158, 11, 0.12); color: #F59E0B;">
                <svg width="22" height="22" viewBox="0 0 24 24" fill="none"
                     stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <circle cx="12" cy="12" r="10" />
                    <path d="M8 14s1.5 2 4 2 4-2 4-2" />
                    <line x1="9" y1="9" x2="9.01" y2="9" />
                    <line x1="15" y1="9" x2="15.01" y2="9" />
                </svg>
            </div>
            <div class="mindora-stat-value">@Model.AverageMoodDisplay</div>
            <div class="mindora-stat-label">Average Mood</div>
        </div>

        <div class="mindora-stat-card">
            <div class="mindora-stat-icon" style="background: rgba(16, 185, 129, 0.12); color: #10B981;">
                <svg width="22" height="22" viewBox="0 0 24 24" fill="none"
                     stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M8.5 14.5A2.5 2.5 0 0 0 11 12c0-1.38-.5-2-1-3-1.072-2.143-.224-4.054 2-6 .5 2.5 2 4.9 4 6.5 2 1.6 3 3.5 3 5.5a7 7 0 1 1-14 0c0-1.153.433-2.294 1-3a2.5 2.5 0 0 0 2.5 2.5z" />
                </svg>
            </div>
            <div class="mindora-stat-value">@Model.CurrentStreak</div>
            <div class="mindora-stat-label">Writing Streak</div>
        </div>

        <div class="mindora-stat-card">
            <div class="mindora-stat-icon" style="background: rgba(236, 72, 153, 0.12); color: #EC4899;">
                <svg width="22" height="22" viewBox="0 0 24 24" fill="none"
                     stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <polyline points="23 6 13.5 15.5 8.5 10.5 1 18"></polyline>
                    <polyline points="17 6 23 6 23 12"></polyline>
                </svg>
            </div>
            <div class="mindora-stat-value">@Model.LongestStreak</div>
            <div class="mindora-stat-label">Longest Streak</div>
        </div>

        @if (!string.IsNullOrEmpty(Model.MostCommonMood))
        {
            <div class="mindora-stat-card">
                <div class="mindora-stat-icon" style="background: rgba(59, 130, 246, 0.12); color: #3B82F6;">
                    <svg width="22" height="22" viewBox="0 0 24 24" fill="none"
                         stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.38 8.38 0 0 1-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.38 8.38 0 0 1 3.8-.9h.5a8.48 8.48 0 0 1 8 8v.5z" />
                    </svg>
                </div>
                <div class="mindora-stat-value" style="font-size: 16px;">@Model.MostCommonMood</div>
                <div class="mindora-stat-label">Most Common Mood</div>
            </div>
        }
    </div>

    <!-- MOOD TIMELINE CHART -->
    <div class="mindora-chart-card">
        <div class="mindora-chart-header">
            <div>
                <h3 class="mindora-chart-title">Mood Timeline</h3>
                <p class="mindora-chart-subtitle">Your mood trends over the last 30 days</p>
            </div>
        </div>
        <div class="mindora-chart-body">
            <canvas id="moodTimelineChart"></canvas>
        </div>
    </div>

    <!-- MOOD DISTRIBUTION + HEATMAP -->
    <div class="row g-3">
        <div class="col-lg-5">
            <div class="mindora-chart-card h-100">
                <div class="mindora-chart-header">
                    <div>
                        <h3 class="mindora-chart-title">Mood Distribution</h3>
                        <p class="mindora-chart-subtitle">How you've been feeling</p>
                    </div>
                </div>
                @if (Model.MoodDistribution.Any())
                {
                    <div class="mindora-chart-body">
                        <canvas id="moodDistChart"></canvas>
                    </div>
                }
                else
                {
                    <div class="text-center py-5 text-muted">
                        <p>No mood data yet</p>
                    </div>
                }
            </div>
        </div>

        <div class="col-lg-7">
            <div class="mindora-chart-card h-100">
                <div class="mindora-chart-header">
                    <div>
                        <h3 class="mindora-chart-title">Writing Calendar</h3>
                        <p class="mindora-chart-subtitle">Last 30 days at a glance</p>
                    </div>
                </div>
                <div class="heatmap-container">
                    <div class="heatmap-grid">
                        @foreach (var day in Model.HeatmapDays)
                        {
                            var cls = day.Wrote ? "heatmap-day completed" : "heatmap-day missed";
                            <div class="@cls" title="@day.Date.ToString("MMM dd, yyyy")"></div>
                        }
                    </div>
                    <div class="heatmap-legend">
                        <span class="heatmap-legend-item">
                            <span class="heatmap-dot completed"></span> Wrote
                        </span>
                        <span class="heatmap-legend-item">
                            <span class="heatmap-dot missed"></span> No Entry
                        </span>
                    </div>
                </div>
            </div>
        </div>
    </div>

</div>

@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', function() {

            // ============================================================
            // MOOD TIMELINE CHART
            // ============================================================
            const moodLabels = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(
                                            Model.MoodTimeline.Select(m => m.Date.ToString("MMM dd")).ToList()));

            const moodData = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(
                                            Model.MoodTimeline.Select(m => m.MoodScore).ToList()));

            MindoraCharts.line('moodTimelineChart', moodLabels, [{
                label: 'Mood',
                data: moodData,
                color: '#06B6D4',
                fill: true
            }], {
                plugins: {
                    tooltip: {
                        callbacks: {
                            label: function(ctx) {
                                return ctx.parsed.y ? `Mood: ${ctx.parsed.y}/10` : 'No entry';
                            }
                        }
                    }
                },
                scales: {
                    y: {
                        beginAtZero: true,
                        max: 10,
                        ticks: { stepSize: 2 }
                    }
                }
            });

            // ============================================================
            // MOOD DISTRIBUTION DOUGHNUT
            // ============================================================
            @if (Model.MoodDistribution.Any())
                {
                    <text>
                            const distLabels = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(
                                                            Model.MoodDistribution.Select(m => m.MoodName).ToList()));
                            const distData = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(
                                                            Model.MoodDistribution.Select(m => m.Count).ToList()));
                            const distColors = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(
                                                            Model.MoodDistribution.Select(m => m.Color).ToList()));

                            MindoraCharts.doughnut('moodDistChart', distLabels, distData, distColors);
                    </text>
            }
                });
    </script>
}