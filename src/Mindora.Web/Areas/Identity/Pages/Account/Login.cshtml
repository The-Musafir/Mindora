@page
@model LoginModel

@{
    ViewData["Title"] = "Sign In";
    Layout = null;
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Sign In | Mindora</title>

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700;800;900&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" />

    <style>
            /* ============================================================
                       AUTH PAGE — ANIMATED BACKGROUND
                       ============================================================ */
            .auth-page {
                position: relative;
                min-height: 100vh;
                background: linear-gradient(135deg, #0F172A 0%, #164E63 50%, #06B6D4 100%);
                display: flex;
                align-items: center;
                justify-content: center;
                padding: 40px 20px;
                font-family: 'Poppins', sans-serif;
                overflow: hidden;
            }

            /* Floating Brand Text Layer */
            .auth-bg-layer {
                position: absolute;
                inset: 0;
                overflow: hidden;
                pointer-events: none;
                z-index: 0;
            }

                .auth-bg-layer span {
                    position: absolute;
                    font-family: 'Poppins', sans-serif;
                    font-weight: 800;
                    color: rgba(255, 255, 255, 0.06);
                    font-size: 4rem;
                    white-space: nowrap;
                    user-select: none;
                    letter-spacing: -0.02em;
                    animation: floatBithix 25s ease-in-out infinite;
                    will-change: transform;
                }

                    .auth-bg-layer span:nth-child(3n) {
                        font-size: 3rem;
                        color: rgba(6, 182, 212, 0.12);
                    }

                    .auth-bg-layer span:nth-child(3n+1) {
                        font-size: 5rem;
                        color: rgba(255, 255, 255, 0.04);
                    }

                    .auth-bg-layer span:nth-child(3n+2) {
                        font-size: 3.5rem;
                        color: rgba(6, 182, 212, 0.08);
                        font-weight: 700;
                    }

                    .auth-bg-layer span:nth-child(1) {
                        top: 5%;
                        left: 8%;
                        animation-duration: 22s;
                        animation-delay: 0s;
                    }

                    .auth-bg-layer span:nth-child(2) {
                        top: 15%;
                        right: 10%;
                        animation-duration: 28s;
                        animation-delay: -5s;
                    }

                    .auth-bg-layer span:nth-child(3) {
                        top: 30%;
                        left: 5%;
                        animation-duration: 26s;
                        animation-delay: -10s;
                    }

                    .auth-bg-layer span:nth-child(4) {
                        top: 45%;
                        right: 5%;
                        animation-duration: 24s;
                        animation-delay: -3s;
                    }

                    .auth-bg-layer span:nth-child(5) {
                        top: 60%;
                        left: 12%;
                        animation-duration: 30s;
                        animation-delay: -8s;
                    }

                    .auth-bg-layer span:nth-child(6) {
                        top: 75%;
                        right: 15%;
                        animation-duration: 27s;
                        animation-delay: -12s;
                    }

                    .auth-bg-layer span:nth-child(7) {
                        top: 85%;
                        left: 8%;
                        animation-duration: 25s;
                        animation-delay: -6s;
                    }

                    .auth-bg-layer span:nth-child(8) {
                        top: 10%;
                        left: 45%;
                        animation-duration: 32s;
                        animation-delay: -15s;
                    }

                    .auth-bg-layer span:nth-child(9) {
                        top: 50%;
                        left: 48%;
                        animation-duration: 29s;
                        animation-delay: -7s;
                    }

                    .auth-bg-layer span:nth-child(10) {
                        top: 90%;
                        right: 40%;
                        animation-duration: 26s;
                        animation-delay: -18s;
                    }

                    .auth-bg-layer span:nth-child(11) {
                        top: 25%;
                        left: 22%;
                        animation-duration: 34s;
                        animation-delay: -2s;
                    }

                    .auth-bg-layer span:nth-child(12) {
                        top: 70%;
                        right: 25%;
                        animation-duration: 23s;
                        animation-delay: -14s;
                    }

            @@keyframes floatBithix {
                0% {
                    transform: translate(0, 0) rotate(-4deg) scale(1);
                    opacity: 0.5;
                }

                25% {
                    transform: translate(40px, -30px) rotate(3deg) scale(1.05);
                    opacity: 0.8;
                }

                50% {
                    transform: translate(-25px, 35px) rotate(-2deg) scale(0.95);
                    opacity: 0.6;
                }

                75% {
                    transform: translate(30px, 20px) rotate(4deg) scale(1.02);
                    opacity: 0.75;
                }

                100% {
                    transform: translate(0, 0) rotate(-4deg) scale(1);
                    opacity: 0.5;
                }
            }

            /* Soft Glowing Blobs */
            .auth-bg-blob {
                position: absolute;
                border-radius: 50%;
                filter: blur(80px);
                pointer-events: none;
                z-index: 0;
                animation: blobPulse 15s ease-in-out infinite;
            }

            .auth-bg-blob-1 {
                width: 400px;
                height: 400px;
                background: rgba(6, 182, 212, 0.35);
                top: -100px;
                left: -100px;
                animation-delay: 0s;
            }

            .auth-bg-blob-2 {
                width: 350px;
                height: 350px;
                background: rgba(8, 145, 178, 0.3);
                bottom: -100px;
                right: -80px;
                animation-delay: -7s;
            }

            .auth-bg-blob-3 {
                width: 250px;
                height: 250px;
                background: rgba(59, 130, 246, 0.25);
                top: 50%;
                right: 20%;
                animation-delay: -3s;
            }

            @@keyframes blobPulse {
                0%, 100% {
                    transform: scale(1) translate(0, 0);
                }

                33% {
                    transform: scale(1.15) translate(30px, -20px);
                }

                66% {
                    transform: scale(0.9) translate(-20px, 30px);
                }
            }

            /* Login Card */
            .auth-card {
                position: relative;
                z-index: 1;
                background: rgba(255, 255, 255, 0.98);
                backdrop-filter: blur(20px) saturate(180%);
                border-radius: 24px;
                box-shadow: 0 25px 60px rgba(0, 0, 0, 0.35), 0 0 0 1px rgba(255, 255, 255, 0.1);
                width: 100%;
                max-width: 440px;
                padding: 48px 40px;
                animation: cardEntry 0.6s ease-out;
            }

            @@keyframes cardEntry {
                from {
                    opacity: 0;
                    transform: translateY(20px) scale(0.98);
                }

                to {
                    opacity: 1;
                    transform: translateY(0) scale(1);
                }
            }

            /* Header */
            .auth-header {
                text-align: center;
                margin-bottom: 32px;
            }

                .auth-header img {
                    height: 52px;
                    margin-bottom: 16px;
                }

                .auth-header h1 {
                    font-size: 26px;
                    font-weight: 700;
                    color: #0F172A;
                    margin-bottom: 6px;
                    letter-spacing: -0.02em;
                }

                .auth-header p {
                    color: #64748B;
                    font-size: 14px;
                    margin: 0;
                }

            /* Social Buttons */
            .social-container {
                display: flex;
                justify-content: center;
                gap: 12px;
                margin-bottom: 6px;
            }

                .social-container .social {
                    width: 44px;
                    height: 44px;
                    display: inline-flex;
                    align-items: center;
                    justify-content: center;
                    border: 1.5px solid #E2E8F0;
                    border-radius: 12px;
                    color: #334155;
                    text-decoration: none;
                    transition: all 0.25s ease;
                    background: #FFFFFF;
                    cursor: not-allowed;
                    opacity: 0.55;
                    position: relative;
                }

                    .social-container .social svg {
                        width: 18px;
                        height: 18px;
                        fill: currentColor;
                    }

                    .social-container .social::after {
                        content: "Soon";
                        position: absolute;
                        top: -8px;
                        right: -8px;
                        background: #F59E0B;
                        color: #FFFFFF;
                        font-size: 8px;
                        font-weight: 700;
                        padding: 2px 5px;
                        border-radius: 999px;
                        letter-spacing: 0.03em;
                        transform: scale(0.85);
                    }

            .social-coming-soon {
                display: block;
                text-align: center;
                font-size: 11px;
                color: #94A3B8;
                margin-bottom: 20px;
                font-style: italic;
            }

            .divider {
                display: flex;
                align-items: center;
                text-align: center;
                color: #94A3B8;
                font-size: 12px;
                margin: 20px 0;
                text-transform: uppercase;
                letter-spacing: 0.05em;
            }

                .divider::before,
                .divider::after {
                    content: '';
                    flex: 1;
                    height: 1px;
                    background: #E2E8F0;
                }

                .divider span {
                    padding: 0 14px;
                }

            /* Form */
            .form-group {
                margin-bottom: 16px;
            }

                .form-group label {
                    display: block;
                    font-size: 13px;
                    font-weight: 500;
                    color: #334155;
                    margin-bottom: 6px;
                }

            .form-control-custom {
                width: 100%;
                padding: 12px 16px;
                border: 1.5px solid #E2E8F0;
                border-radius: 12px;
                font-size: 14px;
                font-family: 'Poppins', sans-serif;
                color: #0F172A;
                background: #FFFFFF;
                transition: all 0.2s ease;
                outline: none;
            }

                .form-control-custom:focus {
                    border-color: #06B6D4;
                    box-shadow: 0 0 0 4px rgba(6, 182, 212, 0.15);
                }

                .form-control-custom::placeholder {
                    color: #94A3B8;
                }

            .field-validation-error {
                display: block;
                font-size: 12px;
                color: #EF4444;
                margin-top: 4px;
            }

            .form-options {
                display: flex;
                align-items: center;
                justify-content: space-between;
                margin-bottom: 20px;
                font-size: 13px;
            }

                .form-options label {
                    display: flex;
                    align-items: center;
                    gap: 6px;
                    color: #64748B;
                    cursor: pointer;
                    margin: 0;
                }

                .form-options input[type="checkbox"] {
                    accent-color: #06B6D4;
                }

                .form-options a {
                    color: #06B6D4;
                    text-decoration: none;
                    font-weight: 500;
                }

                    .form-options a:hover {
                        text-decoration: underline;
                    }

            .btn-submit {
                width: 100%;
                padding: 14px;
                background: linear-gradient(135deg, #06B6D4, #0891B2);
                border: none;
                border-radius: 12px;
                color: #FFFFFF;
                font-size: 15px;
                font-weight: 600;
                font-family: 'Poppins', sans-serif;
                cursor: pointer;
                transition: all 0.25s ease;
                letter-spacing: 0.02em;
                position: relative;
                overflow: hidden;
            }

                .btn-submit::before {
                    content: '';
                    position: absolute;
                    top: 0;
                    left: -100%;
                    width: 100%;
                    height: 100%;
                    background: linear-gradient(90deg, transparent, rgba(255,255,255,0.3), transparent);
                    transition: left 0.5s ease;
                }

                .btn-submit:hover::before {
                    left: 100%;
                }

                .btn-submit:hover {
                    transform: translateY(-2px);
                    box-shadow: 0 10px 24px rgba(6, 182, 212, 0.4);
                }

            .signup-link {
                text-align: center;
                margin-top: 24px;
                padding-top: 20px;
                border-top: 1px solid #E2E8F0;
                font-size: 14px;
                color: #64748B;
            }

                .signup-link a {
                    color: #06B6D4;
                    font-weight: 600;
                    text-decoration: none;
                }

                    .signup-link a:hover {
                        text-decoration: underline;
                    }

            .validation-summary-errors {
                background: rgba(239, 68, 68, 0.08);
                border: 1px solid rgba(239, 68, 68, 0.2);
                border-radius: 12px;
                padding: 12px 16px;
                font-size: 13px;
                color: #DC2626;
                margin-bottom: 20px;
            }

                .validation-summary-errors ul {
                    margin: 0;
                    padding-left: 18px;
                }

            /* Responsive */
            @@media (max-width: 480px) {
                .auth-card {
                    padding: 36px 24px;
                    border-radius: 20px;
                }

                .auth-header h1 {
                    font-size: 22px;
                }

                .auth-bg-layer span {
                    font-size: 2.5rem !important;
                }
            }
    </style>
</head>
<body>

    <div class="auth-page">

        <!-- ANIMATED BACKGROUND -->
        <div class="auth-bg-blob auth-bg-blob-1"></div>
        <div class="auth-bg-blob auth-bg-blob-2"></div>
        <div class="auth-bg-blob auth-bg-blob-3"></div>

        <div class="auth-bg-layer" aria-hidden="true">
            <span>Bithix29</span>
            <span>Bithix29</span>
            <span>Bithix29</span>
            <span>Bithix29</span>
            <span>Bithix29</span>
            <span>Bithix29</span>
            <span>Bithix29</span>
            <span>Bithix29</span>
            <span>Bithix29</span>
            <span>Bithix29</span>
            <span>Bithix29</span>
            <span>Bithix29</span>
        </div>

        <!-- LOGIN CARD -->
        <div class="auth-card">

            <div class="auth-header">
                <img src="/images/logo/Mindora-Logo.svg" alt="Mindora" />
                <h1>Welcome Back</h1>
                <p>Sign in to continue your wellness journey</p>
            </div>

            <!-- Social Icons (SVG — no CDN) -->
            <div class="social-container">
                <a href="#" class="social" title="Coming Soon">
                    <svg viewBox="0 0 24 24"><path d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92c-.26 1.37-1.04 2.53-2.21 3.31v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.09z" fill="#4285F4" /><path d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23z" fill="#34A853" /><path d="M5.84 14.09c-.22-.66-.35-1.36-.35-2.09s.13-1.43.35-2.09V7.07H2.18C1.43 8.55 1 10.22 1 12s.43 3.45 1.18 4.93l2.85-2.22.81-.62z" fill="#FBBC05" /><path d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.07l3.66 2.84c.87-2.6 3.3-4.53 6.16-4.53z" fill="#EA4335" /></svg>
                </a>
                <a href="#" class="social" title="Coming Soon">
                    <svg viewBox="0 0 24 24"><path d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z" fill="#1877F2" /></svg>
                </a>
                <a href="#" class="social" title="Coming Soon">
                    <svg viewBox="0 0 24 24"><path d="M12 0c-6.626 0-12 5.373-12 12 0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23.957-.266 1.983-.399 3.003-.404 1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576 4.765-1.589 8.199-6.086 8.199-11.386 0-6.627-5.373-12-12-12z" fill="#333" /></svg>
                </a>
                <a href="#" class="social" title="Coming Soon">
                    <svg viewBox="0 0 24 24"><path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433c-1.144 0-2.063-.926-2.063-2.065 0-1.138.92-2.063 2.063-2.063 1.14 0 2.064.925 2.064 2.063 0 1.139-.925 2.065-2.064 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z" fill="#0A66C2" /></svg>
                </a>
            </div>
            <span class="social-coming-soon">Social sign in coming soon</span>

            <div class="divider"><span>or sign in with email</span></div>

            <form id="account" method="post">

                <div asp-validation-summary="ModelOnly" class="validation-summary-errors" role="alert"></div>

                <div class="form-group">
                    <label asp-for="Input.Email">Email</label>
                    <input asp-for="Input.Email"
                           type="email"
                           class="form-control-custom"
                           placeholder="you@example.com"
                           autocomplete="email"
                           required />
                    <span asp-validation-for="Input.Email" class="field-validation-error"></span>
                </div>

                <div class="form-group">
                    <label asp-for="Input.Password">Password</label>
                    <input asp-for="Input.Password"
                           type="password"
                           class="form-control-custom"
                           placeholder="Your password"
                           autocomplete="current-password"
                           required />
                    <span asp-validation-for="Input.Password" class="field-validation-error"></span>
                </div>

                <div class="form-options">
                    <label>
                        <input asp-for="Input.RememberMe" type="checkbox" />
                        Remember me
                    </label>
                    <a asp-page="./ForgotPassword">Forgot password?</a>
                </div>

                <button id="login-submit" type="submit" class="btn-submit">
                    SIGN IN
                </button>
            </form>

            <div class="signup-link">
                Don't have an account?
                <a asp-page="./Register">Sign up</a>
            </div>

        </div>
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/jquery-validation/dist/jquery.validate.min.js"></script>
    <script src="~/lib/jquery-validation-unobtrusive/jquery.validate.unobtrusive.min.js"></script>

</body>
</html>