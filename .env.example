# ============================================================
# Mindora — Environment variable template
# ============================================================
# Copy this file to `.env` and fill in real values.
# NEVER commit `.env` — it contains secrets.
# ============================================================

# --- ASP.NET Core runtime ---
ASPNETCORE_ENVIRONMENT=Production
ASPNETCORE_URLS=http://+:8080

# --- Database (production) ---
# Examples:
#   SQL Server:  Server=tcp:myserver.database.windows.net,1433;Database=MindoraDb;User ID=...;Password=...;Encrypt=True;
#   PostgreSQL:  Host=...;Port=5432;Database=mindora;Username=...;Password=...
ConnectionStrings__DefaultConnection=
ConnectionStrings__MindoraDbContext=

# --- Google Gemini AI ---
Gemini__ApiKey=
Gemini__Model=gemini-3.6-flash
Gemini__BaseUrl=https://generativelanguage.googleapis.com/v1beta/models

# --- SSLCommerz payment gateway ---
SSLCommerz__StoreId=
SSLCommerz__StorePassword=
SSLCommerz__SandboxMode=true
SSLCommerz__SuccessUrl=
SSLCommerz__FailUrl=
SSLCommerz__CancelUrl=
SSLCommerz__IpnUrl=

# --- Optional: Application Insights / logging ---
# APPLICATIONINSIGHTS_CONNECTION_STRING=